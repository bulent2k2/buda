#!/bin/bash
set -e

# Format seconds to a human-readable duration (e.g. 1m 15s)
format_duration() {
    local secs=$1
    if [ $secs -ge 60 ]; then
        echo "$((secs / 60))m $((secs % 60))s"
    else
        echo "${secs}s"
    fi
}

START_TIME=$(date +%s)

# Get the repo root (this script lives in <root>/bin) to run from the root
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

# Parse arguments
CLEAN=false
RUN_TESTS=false
TEST_TIER=fast   # fast | mid | slow (cumulative)
PARALLEL=false   # `-p` forces parallel for the fast tier (mid/slow already parallel)
BUILD_WEB=false  # `bb web` builds the Scala.js client only (no C++ build)

usage() {
    cat <<'EOF'
Usage: bb [options]

Build BUDA (incremental by default) and optionally run the test suite.

Build options:
  -c, --clean       Clean rebuild (make clean before building)

Test options (each implies a build first; tiers are cumulative):
  -t, --test, test  Run the FAST tier only       (serial by default; -p to parallelize)
  -m, --mid,  mid   Run FAST + MID tiers          (+full-pipeline integration tests)
  -s, --slow, slow  Run ALL tiers                 (+SA/GA optimizer storms)
  -p, --parallel    Parallelize the run (needed only for the fast tier; mid/slow
                    already parallelize). Implies -t when no tier is given.

The mid/slow tiers run in PARALLEL when pytest-xdist is installed (`-n auto
--dist loadfile`, ~3x on 4 cores); the fast tier is serial unless you pass -p.
Override the worker count with BB_JOBS=<N> (e.g. BB_JOBS=8), or force serial
with BB_JOBS=0.

Web client:
  web               Build the Scala.js client only (sbt fullLinkJS) into the
                    git-ignored src/web/static/scala/main.js, served at /scala/.
                    Needs sbt on PATH; the toolchain-free reference client at /
                    covers the whole flow without this build.

Other:
  -h, --help        Show this help and exit

Tier definitions live in pytest.ini (the `mid` and `slow` markers); per-test
runtimes and the parallelism setup are in docs/internal/test/.

Examples:
  bb              # incremental build, no tests
  bb -c           # clean rebuild, no tests
  bb -t           # build + fast tests (default inner-loop check)
  bb -t -p        # build + fast tests, parallelized (or just: bb -p)
  bb -m           # build + fast + mid (integration) tests
  bb -s           # build + everything, before pushing
EOF
}

for arg in "$@"; do
    case "$arg" in
        --clean|-c)
            CLEAN=true
            ;;
        --test|-t|test)
            RUN_TESTS=true
            ;;
        --mid|-m|mid)
            RUN_TESTS=true
            TEST_TIER=mid
            ;;
        --slow|-s|slow)
            RUN_TESTS=true
            TEST_TIER=slow
            ;;
        --parallel|-p|parallel)
            RUN_TESTS=true   # -p alone -> fast tier in parallel
            PARALLEL=true
            ;;
        web)
            BUILD_WEB=true
            ;;
        --help|-h|help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Try 'bb --help' for usage." >&2
            exit 1
            ;;
    esac
done

# `bb web` — build the Scala.js client only, then exit (no C++ build).
if [ "$BUILD_WEB" = true ]; then
    echo "=== Building the Scala.js web client ==="
    OUT_DIR="$REPO_DIR/src/web/static/scala"
    if ! command -v sbt >/dev/null 2>&1; then
        cat >&2 <<'MSG'
sbt is not on your PATH — the Scala.js client at /scala/ can't be built.

Any recent sbt works; the quickest one-time install is Coursier:
    curl -fsSL https://raw.githubusercontent.com/coursier/launchers/master/coursier -o cs
    chmod +x cs && ./cs install sbt      # then re-run: bb web

You do NOT need this to use BUDA's web demo — the toolchain-free reference
client is served at / and covers the whole flow. Only /scala/ needs this build.
MSG
        exit 1
    fi
    ( cd "$REPO_DIR/web" && sbt fullLinkJS )
    # fullLinkJS emits under scala-<scalaVersion>/buda-web-opt/ (Scala 3 names the
    # dir with the FULL version). Target that exact dir — read scalaVersion from
    # build.sbt — so a stale scala-* dir left by an old version can't be copied
    # instead of the just-built one (which a lexicographic `ls | head -1` would
    # do after a scalaVersion bump). Fall back to the newest matching bundle by
    # mtime (the sbt run just wrote it) if build.sbt can't be parsed.
    SCALAV=$(sed -n 's/^[[:space:]]*scalaVersion[[:space:]]*:=[[:space:]]*"\([^"]*\)".*/\1/p' \
             "$REPO_DIR/web/build.sbt" | head -1)
    BUNDLE=""
    if [ -n "$SCALAV" ] && [ -f "$REPO_DIR/web/target/scala-$SCALAV/buda-web-opt/main.js" ]; then
        BUNDLE="$REPO_DIR/web/target/scala-$SCALAV/buda-web-opt/main.js"
    else
        BUNDLE=$(ls -t "$REPO_DIR"/web/target/scala-*/buda-web-opt/main.js 2>/dev/null | head -1)
    fi
    if [ -z "$BUNDLE" ] || [ ! -f "$BUNDLE" ]; then
        echo "Build produced no bundle under web/target/scala-*/buda-web-opt/" >&2
        exit 1
    fi
    mkdir -p "$OUT_DIR"
    cp "$BUNDLE" "$OUT_DIR/main.js"
    echo "=== Web client built ==="
    echo "Copied $(basename "$BUNDLE") -> src/web/static/scala/main.js (served at /scala/)."
    exit 0
fi

if [ "$CLEAN" = true ]; then
    echo "=== Cleaning and Building BUDA (Clean Build) ==="
else
    echo "=== Building BUDA (Incremental Build) ==="
fi

BUILD_START=$(date +%s)

mkdir -p build
cd build

echo "Configuring with CMake..."
cmake ..

if [ "$CLEAN" = true ]; then
    echo "Cleaning previous build..."
    make clean
fi

echo "Building target (buda)..."
make -j$(sysctl -n hw.ncpu 2>/dev/null || echo 4)

# Remove any stale .so copies from src/ so they cannot shadow the fresh build.
rm -f "$REPO_DIR"/src/buda*.so "$REPO_DIR"/src/libbuda_core*.so
echo "Build artifacts in build/. Use 'PYTHONPATH=build' to run scripts directly."

BUILD_END=$(date +%s)
BUILD_DURATION=$((BUILD_END - BUILD_START))

echo "=== BUDA build successful ==="

TEST_DURATION=0
if [ "$RUN_TESTS" = true ]; then
    echo "=== Running Tests ==="
    export MPLBACKEND="${MPLBACKEND:-Agg}"
    TEST_START=$(date +%s)

    cd ..
    mkdir -p log
    export MPLCONFIGDIR="${MPLCONFIGDIR:-$REPO_DIR/log/matplotlib}"
    mkdir -p "$MPLCONFIGDIR"
    TEST_LOG="log/pytest_$(date +%Y%m%d_%H%M%S).log"
    # Define awk filter for milestone-based progress indicator
    AWK_FILTER='
    BEGIN {
        next_milestone = 0
    }
    {
        if (log_file) {
            print $0 > log_file
            fflush(log_file)
        }
    }
    /\[[[:space:]]*[0-9]+%\]/ {
        match($0, /\[[[:space:]]*[0-9]+%\]/)
        pct_str = substr($0, RSTART, RLENGTH)
        gsub(/[^0-9]/, "", pct_str)
        pct = int(pct_str)
        
        if (pct >= next_milestone) {
            # Find the pytest node id (the "::"-bearing field). It is $1 in
            # serial -v output, but a later field under xdist ("[gwN] [ NN%]
            # PASSED test/...::test_x"), so scan rather than assume $1.
            test_info = $1
            for (i = 1; i <= NF; i++) if ($i ~ /::/) { test_info = $i; break }
            n = split(test_info, parts, "/")
            display_name = parts[n]
            if (length(display_name) > 65) {
                display_name = substr(display_name, 1, 62) "..."
            }
            printf "Progress: [%d%%] %s\n", pct, display_name
            fflush()
            next_milestone = (int(pct / 10) + 1) * 10
        }
        next
    }
    /===|---|FAILURES|test_.*FAILED|collected/ {
        print $0
        next
    }
    '

    case "$TEST_TIER" in
        slow)
            echo "Running pytest (fast + mid + slow tiers)... (output redirected to $TEST_LOG)"
            MARK_OPT=(-o "addopts=")              # clear the default marker filter -> everything
            ;;
        mid)
            echo "Running pytest (fast + mid tiers)... (output redirected to $TEST_LOG)"
            MARK_OPT=(-o 'addopts=-m "not slow"') # keep mid, drop slow
            ;;
        *)
            echo "Running pytest (fast tier only)... (output redirected to $TEST_LOG)"
            MARK_OPT=()                            # use pytest.ini default ("not slow and not mid")
            ;;
    esac

    # Parallelize when pytest-xdist is available: the integration tests are
    # independent and CPU-bound, so `-n auto` gives a big speedup (~3x on 4
    # cores). `--dist loadfile` keeps every test in a file on ONE worker, so
    # tests that share a fixture path (e.g. a viz sidecar next to a common
    # .buda) can't race across workers. The mid/slow tiers always parallelize;
    # the fast tier is serial by default (worker startup barely pays off at its
    # size) but parallelizes on `-p`. Override the worker count with BB_JOBS
    # (e.g. BB_JOBS=8), or disable with BB_JOBS=0 / no xdist.
    XDIST_OPT=()
    if { [ "$TEST_TIER" != "fast" ] || [ "$PARALLEL" = true ]; } && [ "${BB_JOBS:-auto}" != "0" ]; then
        if python -c "import xdist" 2>/dev/null; then
            XDIST_OPT=(-n "${BB_JOBS:-auto}" --dist loadfile)
            echo "  (parallel: pytest-xdist -n ${BB_JOBS:-auto} --dist loadfile)"
        else
            echo "  (serial: 'pip install pytest-xdist' to parallelize this tier)"
        fi
    fi

    set +e
    PYTHONUNBUFFERED=1 python -m pytest -v "${MARK_OPT[@]}" "${XDIST_OPT[@]}" 2>&1 | awk -v log_file="$TEST_LOG" "$AWK_FILTER"
    PYTEST_RC=${PIPESTATUS[0]}
    set -e

    TEST_END=$(date +%s)
    TEST_DURATION=$((TEST_END - TEST_START))
    
    if [ $PYTEST_RC -ne 0 ]; then
        echo "Tests failed. See $TEST_LOG for details."
    fi
fi

END_TIME=$(date +%s)
TOTAL_DURATION=$((END_TIME - START_TIME))

echo ""
echo "=== Time Summary ==="
echo "Building: $(format_duration $BUILD_DURATION)"
if [ "$RUN_TESTS" = true ]; then
    echo "Testing:  $(format_duration $TEST_DURATION)"
fi
echo "Total:    $(format_duration $TOTAL_DURATION)"
