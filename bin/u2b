#!/bin/bash
# u2b — turn a topology unit test into a runnable .buda script and open it in the
# interactive topology explorer.
#
# Usage:
#   u2b <test_name> [unit2buda opts]   # e.g.  u2b test_column_datapath_hvh
#   u2b <file.py::test>                # explicit path::func when the name is ambiguous
#   u2b <test_name> --case 2           # pick a @pytest.mark.parametrize case
#
# Runs tools/unit2buda.py on the named test (recording its Floorplan +
# TopologyGenerator setup, or CLI/BDB-flow commands), writes the equivalent
# .buda to $TMPDIR, then launches the routing CLI (bin/buda) on it — which ends
# with visualize_topologies so the input floorplan and generated candidates open
# in a window.  Any extra args after the test name are forwarded to unit2buda.py
# (e.g. --case N); this wrapper supplies -o itself, so don't pass -o.
# See tools/unit2buda.py --help and docs/BUDA_SCRIPT_REFERENCE.md for details.

set -e

PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"

if [ -z "$1" ]; then
    echo "Usage: u2b <test_name> [unit2buda opts]   (e.g. u2b test_column_datapath_hvh --case 2)" >&2
    exit 1
fi

TEST="$1"; shift   # remaining args ("$@") are forwarded to unit2buda.py

# A filesystem-safe stem for the output name (strip any path::func decoration).
STEM="$(echo "$TEST" | tr '/:.' '___')"
OUT="${TMPDIR:-/tmp}/u2b_${STEM}.buda"

# Forward any extra opts (e.g. --case N); append our -o last so it always wins.
python3 "$PROJECT_ROOT/tools/unit2buda.py" "$TEST" "$@" -o "$OUT"
exec "$PROJECT_ROOT/bin/buda" "$OUT"
