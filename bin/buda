#!/bin/bash
# BUDA environment wrapper
# Sets up PYTHONPATH to include the build directory before running the CLI.

# Get the absolute path of the project root (this script lives in <root>/bin)
PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
BUILD_DIR="$PROJECT_ROOT/build"

# Options that take a VALUE which is NOT a path: the next token must pass
# through verbatim — never taken as the script, never anchored to $PWD.
# (`buda -j 4 flow/x.buda` once rewrote the 4 to "$PWD/4" and argparse died
# with "invalid int value"; attached forms like -j4/--threads=4 were fine.)
is_value_opt() {
  case "$1" in
    -t|--tag|-j|--threads) return 0 ;;
    *) return 1 ;;
  esac
}

# Scan for the first non-option arg (the script) and the --no-viz flag,
# skipping every value-taking option's value.  Sets SCRIPT_ARG / NOVIZ.
scan_script_arg() {
  SCRIPT_ARG=""; NOVIZ=""
  local skip="" a
  for a in "$@"; do
    if [ -n "$skip" ]; then skip=""; continue; fi
    if is_value_opt "$a"; then skip=1; continue; fi
    case "$a" in
      -nv|--no-viz) NOVIZ=1 ;;
      -*) ;;
      *) [ -z "$SCRIPT_ARG" ] && SCRIPT_ARG="$a" ;;
    esac
  done
}

# `open` launches from a different cwd, so anchor every relative path arg to
# THIS cwd — including the `.buda`-less script form the CLI would infer
# (`buda demo/foo` → demo/foo.buda).  Absolute paths, options, and the values
# of non-path options pass through verbatim.  Sets ARGS.
anchor_args() {
  ARGS=()
  local skip="" a
  for a in "$@"; do
    if [ -n "$skip" ]; then ARGS+=("$a"); skip=""; continue; fi
    if is_value_opt "$a"; then ARGS+=("$a"); skip=1; continue; fi
    if [ -e "$a" ]; then
      ARGS+=("$( cd "$( dirname "$a" )" && pwd )/$( basename "$a" )")
    elif [ -e "$a.buda" ]; then
      ARGS+=("$( cd "$( dirname "$a" )" && pwd )/$( basename "$a" ).buda")
    else
      case "$a" in
        -*|/*) ARGS+=("$a") ;;         # option or already-absolute
        *)     ARGS+=("$PWD/$a") ;;     # relative (e.g. missing file): anchor
      esac
    fi
  done
}

# Test hook (any OS): print what the macOS relaunch would compute — the
# detected script arg, then one anchored arg per line — and exit.  Lets the
# arg-handling logic above be unit-tested on Linux CI, where the Darwin
# branch itself cannot run.
if [ -n "$BUDA_TEST_ANCHOR" ]; then
  scan_script_arg "$@"
  echo "SCRIPT_ARG=$SCRIPT_ARG"
  anchor_args "$@"
  printf '%s\n' "${ARGS[@]}"
  exit 0
fi

# macOS: relaunch through a per-cell .app so the Dock tile shows the CELL name
# (the .buda basename) and icon — when you run many cells, that makes the right
# window easy to pick out. LaunchServices sets that identity at launch, while
# this terminal's stdio stays wired via `open --stdin/--stdout/--stderr`
# (macOS 10.15+) and `-W` blocks until exit, so the per-command summary and
# flow-log line still print here. The per-cell bundle is a throwaway written to
# a temp cache; its icon is copied from bin/Buda.app (build it once with
# `python3 tools/make_macos_apps.py`), else set_dock_icon() supplies it at
# runtime. Guarded to an `open` with --stdout and to all THREE of stdin, stdout
# and stderr being ttys — if any is redirected (`buda … >run.log`, `| tee`) we
# fall through to the direct launch so the pipe/file is honored rather than
# `open --stdout "$TTY"` shoving output back at the terminal. Opt out with
# BUDA_NO_APP=1.
if [ "$(uname)" = "Darwin" ] && [ -z "$BUDA_NO_APP" ] \
   && [ -t 0 ] && [ -t 1 ] && [ -t 2 ] \
   && open --help 2>&1 | grep -q -- '--stdout'; then
  # First non-option arg is the script; skip the reroute for --no-viz batch runs
  # (no window to name) and when no script is given (let the CLI print help).
  scan_script_arg "$@"
  if [ -n "$SCRIPT_ARG" ] && [ -z "$NOVIZ" ]; then
    CELL="$( basename "$SCRIPT_ARG" )"; CELL="${CELL%.buda}"
    CELL_APP="${TMPDIR:-/tmp}/buda_cellapps/${CELL}.app"
    mkdir -p "$CELL_APP/Contents/MacOS" "$CELL_APP/Contents/Resources"
    # Launcher (repo root baked in — the bundle lives outside the checkout).
    # Body starts at column 0 so the generated shebang is the first two bytes.
    # 'open' launches apps from / (not the shell's cwd), which would break a
    # flow's CWD-relative paths (import_def_lef flow/def/chip.lef, emit_guides
    # flow/def/out/..., ...) — see docs/internal/opens_interchange.md item 4.
    # Bake the launch cwd into the (per-invocation) launcher so the app run
    # matches a direct terminal run.  $PWD is still the user's cwd here: the
    # PROJECT_ROOT cd above ran in a subshell.
    #
    # Both the launch cwd AND the repo root are baked into this unquoted
    # heredoc, so both are serialised with printf %q first — a checkout or
    # working dir whose name has a quote / backtick / $() / space then lands as
    # a literal path and cannot break the line or inject a command
    # substitution at launcher runtime.  %q output is used UNQUOTED (cd) or as
    # a bare assignment RHS (root=…) — it already escapes, so quoting doubles
    # up; `root` is then referenced quoted (\$root deferred to launcher time).
    LAUNCH_CWD=$( printf %q "$PWD" )
    LAUNCH_ROOT=$( printf %q "$PROJECT_ROOT" )
    cat > "$CELL_APP/Contents/MacOS/$CELL" <<LAUNCH
#!/bin/bash
cd $LAUNCH_CWD || { echo "buda: launch directory is gone" >&2; exit 1; }
root=$LAUNCH_ROOT
export PYTHONPATH="\$root/build:\$root/tools:\$PYTHONPATH"
exec /usr/bin/env python3 "\$root/src/buda_cli.py" "\$@"
LAUNCH
    chmod +x "$CELL_APP/Contents/MacOS/$CELL"
    ICON_KEY=""
    SRC_ICNS="$PROJECT_ROOT/bin/Buda.app/Contents/Resources/buda.icns"
    if [ -f "$SRC_ICNS" ]; then
      cp "$SRC_ICNS" "$CELL_APP/Contents/Resources/${CELL}.icns"
      ICON_KEY="    <key>CFBundleIconFile</key><string>${CELL}</string>"
    fi
    cat > "$CELL_APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>$CELL</string>
    <key>CFBundleDisplayName</key><string>$CELL</string>
    <key>CFBundleExecutable</key><string>$CELL</string>
    <key>CFBundleIdentifier</key><string>com.buda.cell.$CELL</string>
    <key>CFBundlePackageType</key><string>APPL</string>
$ICON_KEY
    <key>NSHighResolutionCapable</key><true/>
    <key>LSMinimumSystemVersion</key><string>10.13</string>
</dict>
</plist>
PLIST
    TTY="$( tty )"
    anchor_args "$@"
    # -n: force a NEW instance even if this cell is already open, so you can run
    # the same flow twice and inspect both windows side by side (without it,
    # `open` just re-activates the running instance and can't rewire stdio).
    exec open -n -W -a "$CELL_APP" --stdin "$TTY" --stdout "$TTY" --stderr "$TTY" \
         --args "${ARGS[@]}"
  fi
fi

# Add build and tools directories to PYTHONPATH
export PYTHONPATH="$BUILD_DIR:$PROJECT_ROOT/tools:$PYTHONPATH"

# Run the buda_cli.py script, passing all arguments
python3 "$PROJECT_ROOT/src/buda_cli.py" "$@"
