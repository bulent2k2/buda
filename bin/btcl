#!/bin/bash
# btcl — run a Tcl flow that drives BUDA (it sources tools/buda.tcl and calls
# buda::start), with an optional -v that opens a viewer on the FINISHED design
# at the end of the flow even when it has no `visualize`.  The Tcl twin of the
# `buda -v` flag, for eyeballing a Tcl test vehicle without editing it.
#
#   btcl flow.tcl [args...]        # run the flow
#   btcl -v flow.tcl [args...]     # …and pop a viewer when the flow ends
#   btcl -j N flow.tcl [args...]   # …with N worker threads for the parallel
#                                  # pipeline stages (the Tcl twin of `buda -j`:
#                                  # planner scoring, NUTS solvers, healer
#                                  # sweeps).  Clamped to the machine's logical
#                                  # CPUs.  `-j max` uses the whole maximum;
#                                  # with no -j the default is HALF the maximum,
#                                  # the same ceiling `buda` applies.  Attached
#                                  # forms -jN and --threads=N work too.
#   btcl -i flow.buda [ckpt.bdb [stage]]
#                                  # run a .BUDA flow, then drop into the
#                                  # interactive pin/edit prompt (auto-detects
#                                  # hier/flat; `replan` replays the flow's own
#                                  # routing tail — tools/buda_interact.tcl).
#                                  # The optional BDB is opened BEFORE the flow
#                                  # so pins persist across sessions even when
#                                  # the flow itself never opens one; the
#                                  # optional stage (topo|plan|nuts|dnuts)
#                                  # RESUMES from the checkpoint instead of
#                                  # rebuilding: setup replayed from the build
#                                  # trace, load_pipeline, re-enter there
#   btcl -b flow.buda              # -i with the checkpoint AUTO-NAMED
#                                  # (<flow_dir>/<stem>.ckpt.bdb) and the flow
#                                  # text pre-flighted first: a flow whose own
#                                  # last open_bdb is non-durable is refused
#                                  # BEFORE the run instead of discarding the
#                                  # route at the end
#   btcl -r [-s stage] flow.buda   # -i resuming from the auto (or discovered)
#                                  # checkpoint, at the DEEPEST stage the build
#                                  # trace records; -s overrides (and implies
#                                  # -r on its own)
#   btcl -- -v.tcl                 # a script whose NAME starts with a dash
#
# The operand is a TCL script.  A `.buda` flow handed to the bare wrapper is
# refused with the two ways to run one (`btcl -i` for the prompt, `buda` for a
# plain run) rather than passed to tclsh, which reads it as Tcl and complains
# about whatever its first line happens to be.
#
# WRAPPER OPTIONS ARE READ ONLY BEFORE THE SCRIPT.  The first non-option word
# is the script, and everything from it onward — including any `-v` of the
# flow's OWN — is passed through untouched, in its original position.  `--`
# ends option parsing explicitly.  This matters because `-v` is a perfectly
# ordinary flag for a flow to want: reading it anywhere on the line stole the
# flow's argument, re-spelled `--visualize` as `-v`, collapsed two occurrences
# into one, moved it to the end, and — worst — turned the viewer on for a
# `btcl flow.tcl -v` that never asked this wrapper for anything.
#
# The request travels as an ENVIRONMENT VARIABLE (BUDA_VIZ_FINAL) rather than
# an injected argv token, so a flow's arguments are exactly what it was given.
# buda::start reads only that: it used to scan `$argv` for a bare `-v`, which
# cannot tell a launcher's request from a flag the flow wants for itself.  With
# no wrapper, `BUDA_VIZ_FINAL=1 tclsh flow.tcl` says the same thing.
PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
# The child buda_server.py self-bootstraps its own imports, but export the
# layer too so a `package require`/helper in the flow resolves the same way.
export PYTHONPATH="$PROJECT_ROOT/build:$PROJECT_ROOT/tools:$PYTHONPATH"

INTERACTIVE=0
MODE_ARGS=()
# A thread request is an integer (optionally signed) or the literal `max`;
# anything else is a wrapper-level error, caught here before an engine is
# spawned.  A NEGATIVE or otherwise out-of-range count is accepted, not
# rejected — buda_cli.resolve_threads clamps it LOUD to [1, max], and `buda -j`
# does exactly that, so rejecting here would break the two launchers' identical
# `-j` semantics (a leading `-` is dropped before the digit check).
valid_threads() {
  [ "$1" = max ] && return 0
  case "${1#-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}
while [ $# -gt 0 ]; do
  case "$1" in
    -v|--visualize) export BUDA_VIZ_FINAL=1; shift ;;
    -i|--interactive) INTERACTIVE=1; shift ;;
    # -b/-r/-s are modes OF the interactive driver: forwarded to it as their
    # long spellings (MODE_ARGS), ahead of the operands, so the driver owns
    # their meaning and the two entry points cannot drift.
    -b|--build)     INTERACTIVE=1; MODE_ARGS+=(--build); shift ;;
    -r|--resume)    INTERACTIVE=1; MODE_ARGS+=(--resume); shift ;;
    -s|--stage)     [ $# -ge 2 ] || { echo "btcl: $1 requires a stage (topo|plan|nuts|dnuts)" >&2; exit 2; }
                    INTERACTIVE=1; MODE_ARGS+=(--stage "$2"); shift 2 ;;
    --stage=*)      INTERACTIVE=1; MODE_ARGS+=(--stage "${1#--stage=}"); shift ;;
    # -j/--threads: the value is NOT a path — it must pass verbatim, never be
    # anchored to $PWD or taken as the script (the `buda -j 4` hazard its own
    # wrapper documents).  It travels to the child engine as an env var, the
    # same shape as BUDA_VIZ_FINAL; buda_server resolves it through buda_cli so
    # `btcl -j` means exactly what `buda -j` means.
    -j|--threads)   [ $# -ge 2 ] || { echo "btcl: $1 requires a thread count" >&2; exit 2; }
                    valid_threads "$2" || { echo "btcl: $1: invalid thread count '$2' (an integer or 'max')" >&2; exit 2; }
                    export BUDA_THREADS_REQUEST="$2"; shift 2 ;;
    -j*)            v="${1#-j}"
                    valid_threads "$v" || { echo "btcl: invalid thread count '$v' (an integer or 'max')" >&2; exit 2; }
                    export BUDA_THREADS_REQUEST="$v"; shift ;;
    --threads=*)    v="${1#--threads=}"
                    valid_threads "$v" || { echo "btcl: invalid thread count '$v' (an integer or 'max')" >&2; exit 2; }
                    export BUDA_THREADS_REQUEST="$v"; shift ;;
    --)             shift; break ;;
    # The header block IS the help, read to the first non-comment line rather
    # than to a hand-picked number — which had already gone stale by four
    # lines and silently truncated the last paragraph.
    -h|--help)      sed -n '2,${/^[^#]/q; s/^# \{0,1\}//; p;}' "${BASH_SOURCE[0]}"
                    exit 0 ;;
    -*)             echo "btcl: unknown option '$1'" >&2; exit 2 ;;
    *)              break ;;          # the script — parsing stops here
  esac
done

# No -j?  Send the launcher DEFAULT, so `btcl` caps the parallel stages exactly
# as `buda` does with no flag (half the machine maximum, applied as the
# BUDA_THREADS ceiling by buda_server).  Only the two launchers impose this — a
# bare `tclsh flow.tcl` sends nothing and keeps the engine's own auto count.
# A value the caller already exported wins (`:-` leaves it untouched).
export BUDA_THREADS_REQUEST="${BUDA_THREADS_REQUEST:-default}"

# A script whose NAME begins with a dash is not a script to tclsh — it reads it
# as an OPTION, runs nothing, drains stdin and returns 0.  Measured on 8.6.14:
#
#   tclsh -v.tcl a      -> ran nothing, exit 0
#   tclsh -- -v.tcl a   -> ran nothing, exit 0     (`--` is not a terminator
#                                                   tclsh honours, so ours
#                                                   cannot simply be handed on)
#   tclsh ./-v.tcl a    -> ran the script
#
# So `--` ends OUR parsing and the operand is normalised to a path tclsh cannot
# misread.  Without this the documented `btcl -- -v.tcl` was a silent no-op that
# still reported success — the worst shape a launcher can have.
if [ $# -gt 0 ]; then
  case "$1" in
    -*) set -- "./$1" "${@:2}" ;;
  esac
fi

# -i drives a .BUDA flow through the interactive prompt driver.  A Tcl flow
# is refused rather than half-worked: it runs its own buda::start and can
# source tools/buda_prompt.tcl itself (as flow/tcl/design.tcl does).
if [ "$INTERACTIVE" = 1 ]; then
  case "$1" in
    *.buda) exec tclsh "$PROJECT_ROOT/tools/buda_interact.tcl" ${MODE_ARGS[@]+"${MODE_ARGS[@]}"} "$@" ;;
    # The engine's own `source` suffix rule, at the launcher seam:
    # `btcl -r resume_flat` means resume_flat.buda when that file exists
    # AND nothing is literally named `resume_flat` — the fallback
    # direction only.  Without the second check, a file named `foo`
    # beside `foo.buda` sailed through and the driver ran `foo` — the
    # suffixless file — as the flow (Codex #805 P1); with it, that shape
    # keeps the refusal below and the user names the one they mean.
    *)      if [ -n "$1" ] && [ ! -f "$1" ] && [ -f "$1.buda" ]; then
              exec tclsh "$PROJECT_ROOT/tools/buda_interact.tcl" ${MODE_ARGS[@]+"${MODE_ARGS[@]}"} "$@"
            fi
            echo "btcl: -i/-b/-r take a .buda flow (a Tcl flow can source" \
                 "tools/buda_prompt.tcl itself)" >&2; exit 2 ;;
  esac
fi

# A `.buda` flow handed to the bare wrapper is the mirror of the case above,
# and it has to be caught HERE because tclsh will not catch it: it reads the
# file as Tcl, so the flow's first line decides the complaint.  `add_block …`
# is an "invalid command name"; a flow whose first line is `source …` gets
# Tcl's OWN source, which resolves the path against a different root and fails
# with `couldn't read file "../tracks/tracks4top.buda"` (measured on
# flow/big_data_test/bigHalf.buda) — a message about a file the user never
# typed, from a command they did not know had run.  Neither names the actual
# mistake, and both arrive after tclsh has already executed part of the flow.
case "$1" in
  *.buda)
    echo "btcl: '$1' is a BUDA flow -- this wrapper runs TCL scripts" >&2
    echo "btcl: to run a .buda flow:" >&2
    echo "btcl:   btcl -i $1     # run it, then the pin/edit prompt" >&2
    echo "btcl:   buda $1        # run it non-interactively" >&2
    exit 2 ;;
esac

exec tclsh "$@"
