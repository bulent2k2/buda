#!/bin/bash
# BUDA floorplanner environment wrapper
# Sets up PYTHONPATH to include the build directory before running the floorplanner.

# Get the absolute path of the project root (this script lives in <root>/bin)
PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
BUILD_DIR="$PROJECT_ROOT/build"

# Handle help before importing the GUI (which needs tkinter / a display).
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  cat <<'EOF'
Usage: fp [file.bdb]

Open the interactive BUDA Floorplanner (Tk/matplotlib GUI) to edit block
placement in a BDB and, optionally, launch the hier routing flow.

Arguments:
  file.bdb    BDB to open; omit for a blank canvas

See also:
  bin/bfp                          demo scenarios (tc1/tc2/tc3) and .buda flows
  docs/FLOORPLANNER_USER_GUIDE.md
EOF
  exit 0
fi

# macOS: relaunch through Floorplanner.app so the Dock tile shows the app's
# name ("Floorplanner") and icon — LaunchServices establishes that identity at
# launch, which no runtime API can do for a bare `python3` process. Opt out
# with BUDA_NO_APP=1 (keeps output on this terminal, handy for debugging).
# Build the bundle once with:  python3 tools/make_macos_apps.py
APP="$PROJECT_ROOT/bin/Floorplanner.app"
if [ "$(uname)" = "Darwin" ] && [ -z "$BUDA_NO_APP" ] && [ -d "$APP" ]; then
  # `open` launches from a different cwd, so anchor every relative path arg to
  # THIS cwd; absolute paths and options pass through.
  ARGS=()
  for a in "$@"; do
    if [ -e "$a" ]; then
      ARGS+=("$( cd "$( dirname "$a" )" && pwd )/$( basename "$a" )")
    else
      case "$a" in
        -*|/*) ARGS+=("$a") ;;
        *)     ARGS+=("$PWD/$a") ;;
      esac
    fi
  done
  # -n: new instance each time, so two floorplanners can run side by side.
  exec open -n -a "$APP" --args "${ARGS[@]}"
fi

# Add build and tools directories to PYTHONPATH
export PYTHONPATH="$BUILD_DIR:$PROJECT_ROOT/tools:$PYTHONPATH"

# Run the floorplanner prototype, passing all arguments
python3 "$PROJECT_ROOT/tools/bdb_floorplanner.py" "$@"
