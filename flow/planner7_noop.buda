source tracks_flip_orient.buda
add_block b1   0   0  50  50
add_block b2 250 200 300 250
add_bus v[16] b1.o b2.i
add_bus w[16] b2.i b1.o
run_bundler strict
generate_topologies

# infeasible if both bundles pick the third topo:
# select_topologies 1,2 3

# free bundle 1 to rip it up and reroute after bundle 2
select_topology 2 3

# first bundle picks the third topo, second bundle picks the fourth topo
# select_topologies 1 3 2 4

# visualize_topologies

# if all bundles are assigned a topology, we don't need the planner,
# but we can still run it to see the congestion
run_planner
run_nuts

run_detailed_nuts

visualize
