source mix_tracks.buda
open_bdb mix2.bdb.sql

# Bottom-up template planning: every hierarchical cell's local interconnect
# is planned + NUTSed once per template and copied to all instances; the
# copies become fixed blockages the top-level bundles detour.
set_bottom_up dnuts1
set_bottom_up dnuts2
set_bottom_up dogleg1
set_bottom_up dogleg2

# Placement-stage alignment: BEFORE derive_busterms, check whether all
# occurrences of each marked cell see the same signal tracks (whole-window
# comparison — no routing needed), then nudge them onto a common track
# phase with minimal total movement (subtree-aware; each shift is at most
# half the layer-pitch LCM).
check_template_tracks
align_bottom_up
check_template_tracks

derive_busterms 2
add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip
add_blocks_from_bdb 2 skip
run_hier_bundler depth 2
# dump_hbundles
generate_hier_topologies
run_planner hier 5 signal_tracks
dump_topologies
run_nuts
# Post-routing verification (per routed-segment window) — the DNUTS gate.
# Aligned cells solve DNUTS once per template and copy bits to siblings;
# the default on_mismatch policy is 'stop' (use 'independent' to solve any
# residual misaligned instances individually instead).
check_template_tracks
run_detailed_nuts
visualize
exit
