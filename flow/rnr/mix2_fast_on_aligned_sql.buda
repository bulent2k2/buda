# fast flow: 5.39s
# slow flow: 62.96s with nc/rr (a+b) reduce overlaps/opens
# from 28/247 (on 14 bundles) to 5/20 (on 2 bundles)
source mix_tracks.buda
open_bdb mix2_aligned.bdb.sql # from mix2_align_and_save.buda
check_template_tracks
derive_busterms 2
add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip
add_blocks_from_bdb 2 skip
run_hier_bundler depth 2
# dump_hbundles
#
# NOTE: this flow's 2/16/1 residual is the corpus's LAST live example of a
# supply-doomed seat outside chip3a — b61's 16-bit `top_bus20_w16` cannot fit
# the real signal-track supply anywhere (M6 seat: 12 tracks; only adequate
# sibling M4: 17 tracks, 16 held by other buses).  It is kept BROKEN on
# purpose, as the exemplar `tools/doomed_seat_forensics.py` and the
# `check_design` doomed-seat census are read against.
#
# A fix is available and deliberately NOT applied — measured 2026-08-04:
#     set_max_bundle_bits 8 for top_bus20_w16   (before run_hier_bundler)
#     refine_selection                          (at the end)
# gives 2/12/1 at abstract WL 75828 vs the baseline's 76368 — better
# unplaced, parity on overlaps/viol, CHEAPER wire, and doomed TOP seats 1->0.
# Applying it would erase the exemplar, which is the same trade the
# `band_span_charge 0` pin is refused for at the top of
# flow/rnr/mix2_topdown_refine.buda: do not silence a vehicle that exists to
# report a known real residual.  See docs/script_reference/bundling.md
# ("Scoped caps") and docs/internal/wishlist-healer.md.
generate_hier_topologies
# NOTE: deliberately does NOT declare `set_planner_param healersAhead 1`
# (mix2.buda, its parent, does) even though it heals below.  Measured
# 2026-08-03: declaring REGRESSES this flow — 2/16/1 -> 3/30/2.
# Do not 'fix' this.  See docs/internal/ksegs_default_audit.md.
run_planner hier 5 signal_tracks
dump_topologies
run_nuts
# Healing stage a (respects the locked bottom-up copies — never re-routed):
# negotiate the measured NUTS overlaps as band demand, then rnr hill-climbs.
negotiate_congestion
ripup_reroute
check_design nuts
# Post-routing verification (per routed-segment window) — the DNUTS gate.
# Aligned cells solve DNUTS once per template and copy bits to siblings;
# the default on_mismatch policy is 'stop' (use 'independent' to solve any
# residual misaligned instances individually instead).
check_template_tracks
run_detailed_nuts
# Healing stage b: negotiate each DNUTS-open segment's window, then hill-climb.
negotiate_congestion
ripup_reroute
check_design
visualize
exit
