source mix_tracks.buda
# Diffable serialized BDB (see docs/internal/bdb_test_data.md): open_bdb loads the
# *.sql text into a throwaway temp binary, so this flow never dirties the fixture.
open_bdb mix.bdb.sql
derive_busterms 2
add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip
add_blocks_from_bdb 2 skip
run_hier_bundler depth 2
dump_hbundles
# Midpoint-only pool (hanan_loci default-flip opt-out, owner decision): this
# flow's fully-healed 0 overlaps / 0 opens endpoint is a regression target,
# and the default-on loci pool regresses it to 42 dnuts-unplaced (2 bundles)
# at det WL +0.13% with no DISCONNECTED involved — see wishlist-topo
# "Nominal-WL comparability" piece (a) (final flip table + the mix-loci
# root-cause follow-on).
generate_hier_topologies no_hanan_loci
# improvement (1) due to signal_tracks:
run_planner hier 5 signal_tracks
run_nuts
check_design nuts
# improvement (2) negotiated congestion: feed the measured NUTS overlaps
# back into the planner as band demand (bundles re-route by cost, no
# trial-and-error), then the rnr stage-a hill-climb finishes the residual:
negotiate_congestion
ripup_reroute
report_wirelength
run_detailed_nuts
check_design dnuts
# improvement (3) (rnr stage b) to reduce number of bit seg opens — negotiate
# first (each open segment's window is injected as band demand, teaching the
# planner what DetailedNUTS measured), then the hill-climb finishes:
negotiate_congestion
ripup_reroute
check_design dnuts
report_wirelength
visualize
