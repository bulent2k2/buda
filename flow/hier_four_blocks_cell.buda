# ============================================================
# hier_four_blocks_cell.buda
# Same three-tier design as hier_four_blocks.buda but uses
# add_inst_to_cell to define cell structure once; each top-
# level add_inst eagerly expands the full subtree.
#
# Cell definitions:
#   blk  300×230  — top-level quadrant (4 instances)
#   sub  120×90   — sub-block (4 per blk, 2×2 grid)
#   leaf  45×50   — leaf cell  (2 per sub, side by side)
#
# Result: identical 32-block floorplan to hier_four_blocks.buda
# ============================================================

# ── Layers ────────────────────────────────────────────────
source tracks/tracks.buda

corner_margin 1 1
set_min_stub_length 1
set_min_stub_length_dir V 2
set_min_stub_length_layer M5 3

# ── BDB: cell sizes ───────────────────────────────────────
open_bdb :memory:
# open_bdb hier_4_units.bdb
add_cell blk  300 230
add_cell sub  120  90
add_cell leaf  45  50

# ── BDB: cell structure (no component rows yet) ───────────
# blk contains 4 subs in a 2×2 grid
#                      parent inst  child   x    y
add_inst_to_cell  blk  s1    sub   15   15
add_inst_to_cell  blk  s2    sub  155   15
add_inst_to_cell  blk  s3    sub   15  125
add_inst_to_cell  blk  s4    sub  155  125

# sub contains 2 leaves side by side
add_inst_to_cell  sub  l    leaf  10   20
add_inst_to_cell  sub  r    leaf  65   20

# ── BDB: place top-level instances ────────────────────────
# Each add_inst eagerly expands: 1 blk + 4 subs + 8 leaves = 13 rows
add_inst u1  blk  -   50   50
add_inst u2  blk  -  400   50
add_inst u3  blk  -   50  330
add_inst u4  blk  -  400  330

# ── Populate floorplan from BDB (leaf cells at depth 2) ───
add_blocks_from_bdb 2 skip

# ── Buses ─────────────────────────────────────────────────
# b1: u1 NW leaf → u2 NW leaf  (horizontal crossing)
add_bus b1[4]  u1/s1/l.tx  u2/s1/l.rx

# b2: u1 SE leaf → u3 SE leaf  (vertical crossing)
add_bus b2[3]  u1/s4/r.tx  u3/s4/r.rx

# b3: u2 SW leaf → u4 SW leaf  (diagonal)
add_bus b3[2]  u2/s3/l.tx  u4/s3/l.rx

# b4: u3 NW leaf → u1/u2/u4 leaves  (multicast from lower-left)
add_bus b4[5]  u3/s1/l.tx  u1/s1/r.rx,u2/s1/r.rx,u4/s1/r.rx

# ── Pipeline ─────────────────────────────────────────────
run_bundler strict
generate_topologies
check_design topo
run_planner 1
run_nuts
check_design nuts
run_detailed_nuts
check_design dnuts
visualize
