# two blocks that touch on one corner only
source tracks/tracks.buda
add_block u1 0     0 100 100
add_block u2 100 100 200 200
add_bus b[8] u1 u2
run_bundler
# with the default (dx=dy=0), we now get only 2 L topos. With double_detour more. 
# corner_margin dx 1 dy 1  # corner margin transforms it to a regular non-overlap case
generate_topologies # double_detour
run_planner
run_nuts
run_detailed_nuts
visualize
