# ============================================================
# From planner_simple_I_topo_congestion.buda add one block
# on top to open things up
# ============================================================

source tracks2top.buda

add_block u1    50   50   100 100
add_block u2    150  50   200 100
add_block dummy 50   150  160 200

add_bus b1[8] u1.tx u2.rx
add_bus b2[8] u2.tx u1.rx

run_bundler strict

generate_topologies
check_connectivity topo
run_planner 1

run_nuts
check_connectivity nuts
run_detailed_nuts
check_connectivity dnuts

visualize
