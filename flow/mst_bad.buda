source tracks/tracks4top.buda
source big_data_test/tc3a_flat_5x.buda
run_bundler
#                                                                with hanan-loci  w/o
generate_topologies_for_bundle bus_007 no_hanan_loci  # 6 terms: 81 candidates -> 48
generate_topologies_for_bundle bus_033 no_hanan_loci  # 4 terms: 51 candidates -> 33
generate_topologies_for_bundle bus_044 no_hanan_loci  # 5 terms: 56 candidates -> 34
