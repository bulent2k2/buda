def_layer 4 M4 H TOP 0.0
def_layer 5 M5 V TOP 0.0
def_layer 6 M6 H TOP 0.0

add_block u1    50   50   100 100
add_block u2    150  50   200 100
add_block u3    50  150   100 200

#add_net b1 u1.tx u2.rx
#add_net b2 u1.tx u3.rx
#add_net b3 u2.tx u3.rx
add_bus bb1[8] u1.tx u2.rx
add_bus bb2[4] u1.tx u3.rx
add_bus bb3[4] u2.tx u3.rx

run_bundler strict
generate_topologies_for_bundle bb1 u1 u2
generate_topologies_for_bundle bb2 u1 u3
generate_topologies_for_bundle bb3 u2 u3
run_planner 1
#visualize
run_nuts 2.0
visualize
