# two.buda rotated 90° CW: (x,y) → (y, 750-x)
# Original x-range [-150,750] maps to new y-range [0,900].
# Original y-range [100,1000] maps to new x-range [100,1000].
# Corner margins swap: dx=old_dy=20, dy=old_dx=15.

def_layer 4 M4 H TOP 0.0
def_layer 5 M5 V TOP 0.0

corner_margin dx 20 dy 15

# original u0   200 400 300 600
add_block u0    400  450  600  550

# original u11  500 800 550 1000
add_block u11   800  200 1000  250
# original u12  550 600 600 1000
add_block u12   600  150 1000  200
# original u13  600 500 650 1000
add_block u13   500  100 1000  150
# original u14  650 400 700 1000
add_block u14   400   50 1000  100
# original u15  700 200 750 1000
add_block u15   200    0 1000   50

# original u21 -150 500 -100 600
add_block u21   500  850  600  900
# original u22 -100 400  -50 600
add_block u22   400  800  600  850
# original u23  -50 300    0 600
add_block u23   300  750  600  800

# original u31    0 450  50 550
add_block u31   450  700  550  750
# original u32   50 400 100 550
add_block u32   400  650  550  700
# original u33  100 350 150 550
add_block u33   350  600  550  650

# original u41  400 200 500 400
add_block u41   200  250  400  350
# original u51  500 100 600 300
add_block u51   100  150  300  250

add_net n11 u0.tx u11.rx
add_net n12 u0.tx u12.rx
add_net n13 u0.tx u13.rx
add_net n14 u0.tx u14.rx
add_net n15 u0.tx u15.rx

add_net n21 u0.tx u21.rx
add_net n22 u0.tx u22.rx
add_net n23 u0.tx u23.rx

add_net n31 u0.tx u31.rx
add_net n32 u0.tx u32.rx
add_net n33 u0.tx u33.rx

add_net n41 u0.tx u41.rx
add_net n51 u0.tx u51.rx

run_bundler strict
generate_topologies
run_planner 1
run_nuts

# Stage 8: simple power-signal track grid on both routing layers.
# Pattern: POWER(3) sig(2) sig(2) sig(2) GROUND(3) sig(2) sig(2) sig(2)
# unit_pitch = 26;  6 signal tracks per unit.
def_track_pattern 4 0  POWER 3 1  (SIGNAL 2 1)x3  GROUND 3 1  (SIGNAL 2 1)x3
def_track_pattern 5 0  POWER 3 1  (SIGNAL 2 1)x3  GROUND 3 1  (SIGNAL 2 1)x3

run_detailed_nuts

visualize
