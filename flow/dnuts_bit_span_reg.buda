# used in unit test: test_detailed_nuts.py
# two stubs connecting to a trunk
# some of the bits of the trunk got overstretched beyond the far stub they connect to

source tracks2top.buda
add_block drv1    50  380  230  620
add_block rcv1   680  120  880  500
add_block rcv2   350   50  550  230

add_bus b[16] rcv1.o drv1.i,rcv2.i

run_bundler strict
generate_topologies
run_planner
run_nuts
run_detailed_nuts
visualize
