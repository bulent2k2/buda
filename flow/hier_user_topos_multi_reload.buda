# Reload check for hier_user_topos_multi.bdb.sql: a fresh session reopens
# the persisted fixture and restores the hand-built USER topologies.
# (Layers are session state, not stored in the BDB — re-declare them.)
def_layer 4 M4 H TOP 10
def_layer 5 M5 V TOP 10
corner_margin dx 5 dy 5
set_min_stub_length 2

open_bdb hier_user_topos_multi.bdb.sql

add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip
# Plain load_pipeline restores the pre-expansion view: the two sub-cell
# TEMPLATES (bundles 1 = core_cell, 5 = io_cell) + the top-level
# cross-block bundle (2), each with its hand-built USER candidate pinned.
load_pipeline

dump_user_ops 1
dump_user_ops 5
dump_user_ops 2
