# From dnuts1.buda

def_layer 4 M4 H TOP 55.56
def_layer 5 M5 V TOP 55.56
def_track_pattern 4 0  POWER 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  GROUND 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5
def_track_pattern 5 0  POWER 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  GROUND 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5

# testing overrides on M4
add_grid_override 4  900 500 1000 600  0.0  POWER 5 1  SIGNAL 1 1 SIGNAL 1 1 GROUND 10 1 SIGNAL 1 1  SIGNAL 1 1

# Add a Keepout Zone on M4/M5 to see impact on tracks:
add_keepout     940 520 980 540   M4 M5

add_block u0    400  450  600  550
add_block u11   800  200 1000  250
add_block u12   600  150 1000  200
add_block v0    800  450 1000  550
add_bus n11[32] u0.tx u11.rx
add_bus n12[32] u0.tx u12.rx
add_bus bv1[16] u0.tx v0.rx
add_bus bv2[16] v0.tx u11.rx
add_bus r12[32] u12.rx u0.tx

run_bundler strict
generate_topologies
run_planner 1
run_nuts
run_detailed_nuts
visualize
