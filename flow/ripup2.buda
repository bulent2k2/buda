# Rip-up victim TARGETING regression: same conflict as ripup1 (bundle a
# parks in the only band pinned bundle b can use), plus an unrelated bus i
# in a disjoint channel (y[400,700]) that commits BETWEEN them.
# Victim ranking by contended-band overlap must rip bundle a (the actual
# blocker) directly and never touch bundle i (zero overlap, skipped).

source tracks/tracks2top.buda

add_block asrc    0   0  100 300
add_block adst  900   0 1000 300
add_block bsrc  300  40  420 160
add_block bdst  600  40  720 160
add_block isrc    0 400  100 700
add_block idst  900 400 1000 700

add_bus a[24] asrc.o adst.i
add_bus b[16] bsrc.o bdst.i
add_bus i[20] isrc.o idst.i

run_bundler strict
generate_topologies
select_topology 2 1
run_planner
run_nuts
run_detailed_nuts
