# nuts_corner_touch.buda — CROSS-trunk-layer corner overlap (M4 vs M6).
#
# Two buses are pinned to Z-topos whose first V-stubs share the x≈98 column (u1
# and u3), so on M5 they would meet end-to-end.  The sidecar nuts_corner_touch.json
# pins bus x's H-trunk to M4 (seg_layers [5,4,5]); bus y's trunk defaults to M6 —
# so the two trunks sit on DIFFERENT layers, both near y≈125, over ALIGNED M4/M6
# signal grids (same origin/pattern).
#
# Abstract NUTS resolves the corner overlap by nudging the trunks to opposite
# sides of a split (abstract g=1).  Detailed NUTS carries that split bound and
# snaps each trunk to signal tracks on its bounded side, so the trunks land on
# DISJOINT real tracks and the M5 stubs no longer meet — 0 overlaps, 0 unplaced,
# no bit-level short.  See docs/future/nuts_packing_gaps.md §3.
#
# (flow/xlayer_short.buda is a standalone, self-documenting copy of this repro.)

def_layer 4 M4 H TOP 52.94
def_layer 5 M5 V TOP 50.00
def_layer 6 M6 H TOP 52.94
def_track_pattern 4 -400  POWER 4 1  SIGNAL 2 1  SIGNAL 2 1 SIGNAL 2 1  SIGNAL 2 1  GROUND 4 1  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1
def_track_pattern 5    0  POWER 3 1  SIGNAL 2 1  SIGNAL 2 1 SIGNAL 2 1  SIGNAL 2 1  GROUND 3 1  SIGNAL 2 1 SIGNAL 2 1 SIGNAL 2 1  SIGNAL 2 1
def_track_pattern 6 -400  POWER 4 1  SIGNAL 2 1  SIGNAL 2 1 SIGNAL 2 1  SIGNAL 2 1  GROUND 4 1  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1

add_block u1    80   50   100 100
add_block u2    150  50   200 100
add_block u3    80  150   100 200
add_block u4    175 150   225 200

add_bus x[4]  u1.o u4.i
add_bus y[4]  u3.o u2.i

run_bundler strict

corner_margin dy 2 dx 2
set_min_stub_length 2
generate_topologies
check_connectivity topo

# Pin bus y's Z-topo (index 4); bus x is pinned via the sidecar (which also puts
# its trunk on M4).  Together: x trunk → M4, y trunk → M6 (cross-layer).
select_topologies 2 4
run_planner 1

run_nuts
check_connectivity nuts
run_detailed_nuts
check_connectivity dnuts

visualize
