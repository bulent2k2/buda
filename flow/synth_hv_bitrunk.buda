# Synthetic case 1 — HV-BiTrunk (BITRUNK_HVH).
# A source column (left) fans 8-bit buses to receivers in three x-aligned COLUMNS
# (separated in x, stacked in y).  A root H spine (M6) feeds V branch-trunks (M7/M5)
# down each column — BITRUNK_HVH — which beats plain trunks once several buses share
# the columns.  OFF sits off-grid (the "one-off that doesn't fit the datapath").
# Inline M4/M5/M6/M7 track patterns so DetailedNUTS (per-bit) can place + render.
def_layer 6 M6 H TOP 50
def_layer 7 M7 V TOP 50
def_layer 4 M4 H 50
def_layer 5 M5 V 50
def_track_pattern 4 -200  POWER 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  GROUND 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5
def_track_pattern 5    0  POWER 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  GROUND 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5
def_track_pattern 6 -400  POWER 3 1  SIGNAL 1 1  SIGNAL 1 1  SIGNAL 1 1  SIGNAL 1 1  GROUND 3 1  SIGNAL 1 1  SIGNAL 1 1  SIGNAL 1 1  SIGNAL 1 1
def_track_pattern 7 -600  POWER 6 2  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1  GROUND 6 1  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1  SIGNAL 2 1

add_block S0 0 100 80 180
add_block S1 0 220 80 300
add_block S2 0 340 80 420
add_block S3 0 460 80 540
add_block S4 0 580 80 660
add_block S5 0 700 80 780

add_block D0_0 500 60 580 140
add_block D0_1 500 240 580 320
add_block D0_2 500 420 580 500
add_block D0_3 500 600 580 680
add_block D0_4 500 780 580 860
add_block D1_0 850 60 930 140
add_block D1_1 850 240 930 320
add_block D1_2 850 420 930 500
add_block D1_3 850 600 930 680
add_block D1_4 850 780 930 860
add_block D2_0 1200 60 1280 140
add_block D2_1 1200 240 1280 320
add_block D2_2 1200 420 1280 500
add_block D2_3 1200 600 1280 680
add_block D2_4 1200 780 1280 860

add_block OFF 250 980 330 1060

add_bus bus0[8] S0.p D0_0.p,D0_1.p,D0_2.p,D0_3.p,D0_4.p,D1_0.p,D1_1.p,D1_2.p,D1_3.p,D1_4.p,OFF.p
add_bus bus1[8] S1.p D1_0.p,D1_1.p,D1_2.p,D1_3.p,D1_4.p,D2_0.p,D2_1.p,D2_2.p,D2_3.p,D2_4.p
add_bus bus2[8] S2.p D2_0.p,D2_1.p,D2_2.p,D2_3.p,D2_4.p,D0_0.p,D0_1.p,D0_2.p,D0_3.p,D0_4.p
add_bus bus3[8] S3.p D0_0.p,D0_1.p,D0_2.p,D0_3.p,D0_4.p,D1_0.p,D1_1.p,D1_2.p,D1_3.p,D1_4.p
add_bus bus4[8] S4.p D1_0.p,D1_1.p,D1_2.p,D1_3.p,D1_4.p,D2_0.p,D2_1.p,D2_2.p,D2_3.p,D2_4.p
add_bus bus5[8] S5.p D2_0.p,D2_1.p,D2_2.p,D2_3.p,D2_4.p,D0_0.p,D0_1.p,D0_2.p,D0_3.p,D0_4.p

run_bundler
generate_topologies multi_trunk
run_planner
run_nuts
run_detailed_nuts
visualize
