# snippet from two_rotated_buses.buda
# bundle 2
def_layer 4 M4 H TOP 33.33
def_layer 5 M5 V TOP 33.33
corner_margin dx 20 dy 8
add_block u0    400  450  600  550
add_block u12   600  150 1000  200
add_bus n12[8] u0.tx u12.rx
run_bundler strict
generate_topologies
run_planner 1
run_nuts
def_track_pattern 4 0  POWER 2 1  (SIGNAL 1 0.5)x4  GROUND 2 1  (SIGNAL 1 0.5)x4
def_track_pattern 5 0  POWER 2 1  (SIGNAL 1 0.5)x4  GROUND 2 1  (SIGNAL 1 0.5)x4
run_detailed_nuts
visualize
