# ============================================================
# flow/rv/soc_conv_div.buda
#
# soc.buda with the bundler asked for TWO relations at once:
#
#   run_hier_bundler depth 4 CONVERGENT DIVERGENT
#
# A strategy names one relation, which is enough until a design
# carries more than one SHAPE.  This one does, in both directions:
#
#   boot[0..31]   32 die pads  ->  u_imem       a fan-IN
#   dbg[0..31]    u_ixb/u_dmux ->  32 die pads  a fan-OUT
#
# CONVERGENT bundles the first and splits the second; DIVERGENT
# does exactly the opposite.  Neither bundles both, and COMBINED
# is the join of CONVERGENT and BIDIRECTIONAL, so it does not
# either.  Naming the SET gets both — the union-find join already
# worked over a set of relations; only the way to ask was missing.
#
#   strategy               bundles   abstract WL    detailed WL
#   STRICT                     127    31,234,654    409,819,470
#   CONVERGENT                  89    29,771,517    464,297,620
#   DIVERGENT                   78    19,104,008    430,511,600
#   CONVERGENT DIVERGENT        40    16,766,857    472,522,550
#
# Every one of them ends clean with 0 unplaced bits.  The trend is
# the honest summary: the more you bundle, the more trunk is
# shared (abstract WL down 46% at the join) and the further each
# tree has to reach to its leaves (detailed WL up 15%).  Which
# point on that curve a design wants is the design's call, which
# is why this is a fourth script and not a change to soc.buda.
#
# Regenerate the three input files with: python3 flow/rv/gen_soc.py
# ============================================================

open_bdb :memory:

set_import_scale dbu
set_unit_check on

corner_margin dx 3000 dy 3000
set_min_stub_length 1000

import_lef_tech soc.lef
import_def_lef soc.def soc.lef
import_verilog soc.v
derive_container_bboxes margin 4000

derive_busterms 4

add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip
add_blocks_from_bdb 2 skip
add_blocks_from_bdb 3 skip
add_blocks_from_bdb 4 skip

# The one line that differs from soc.buda.
run_hier_bundler depth 4 CONVERGENT DIVERGENT
dump_hbundles

generate_hier_topologies

set_planner_param healersAhead 1
run_planner hier 5

run_nuts
check_design nuts

run_detailed_nuts
check_design dnuts

negotiate_congestion 10
ripup_reroute 20
refine_selection

check_design dnuts
report_wirelength

visualize
