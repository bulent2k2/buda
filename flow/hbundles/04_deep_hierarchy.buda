# ============================================================
# hbundles/04_deep_hierarchy.buda
#
# Three-level hierarchy (depth 0 → 1 → 2) exercising
# run_hier_bundler depth 2 and generate_hier_topologies with
# bundles at multiple levels.
#
# Cell structure:
#   chip  (top, depth 0) — two instances: left, right
#   blk   (mid, depth 1) — two per chip:  top-half, bot-half
#   leaf  (bottom, depth 2) — two per blk: lo-side, hi-side
#
# Physical layout (depth-2 leaf positions, absolute):
#
#   left chip  (0,0)–(400,500):
#     left/top  blk (10,260)–(190,490):
#       left/top/lo  leaf ( 20,310)–( 90,440)
#       left/top/hi  leaf (100,310)–(170,440)
#     left/bot  blk (10, 10)–(190,240):
#       left/bot/lo  leaf ( 20, 60)–( 90,190)
#       left/bot/hi  leaf (100, 60)–(170,190)
#
#   right chip  (450,0)–(850,500):
#     right/top  blk (460,260)–(640,490):
#       right/top/lo  leaf (470,310)–(540,440)
#       right/top/hi  leaf (550,310)–(620,440)
#     right/bot  blk (460, 10)–(640,240):
#       right/bot/lo  leaf (470, 60)–(540,190)
#       right/bot/hi  leaf (550, 60)–(620,190)
#
# Buses (all 4-bit):
#
#   cross-chip (depth-0):
#     x_top    left/top/hi  → right/top/lo    horizontal crossing
#     x_bot    left/bot/hi  → right/bot/lo    horizontal crossing
#
#   intra-left (depth-1, cell-level on blk):
#     l_tb     left/top/lo  → left/bot/hi     vertical within left chip
#
#   intra-blk (depth-2, cell-level on blk):
#     b_lohi   left/top/lo  → left/top/hi     within left/top blk
#
# Expected HBundle structure after run_hier_bundler depth 2:
#   D0: x_top, x_bot                              (cross-chip)
#   D1: l_tb   cell_context=chip  (intra-chip)
#   D2: b_lohi cell_context=blk   instances=[left/top, left/bot,
#                                             right/top, right/bot]
# ============================================================

source ../tracks/tracks.buda

corner_margin dx 5 dy 5
set_min_stub_length 2

# ── BDB: cell sizes ────────────────────────────────────────
open_bdb :memory:

add_cell chip_cell  400 500
add_cell blk_cell   180 230
add_cell leaf_cell   70 130

# ── BDB: cell hierarchy ────────────────────────────────────
# chip contains 2 blk cells (top-half and bot-half)
add_inst_to_cell  chip_cell  top   blk_cell   10  260
add_inst_to_cell  chip_cell  bot   blk_cell   10   10

# blk contains 2 leaf cells (lo and hi, side by side)
add_inst_to_cell  blk_cell   lo    leaf_cell  10   50
add_inst_to_cell  blk_cell   hi    leaf_cell  90   50

# ── BDB: place top-level instances ────────────────────────
add_inst left   chip_cell  -     0    0
add_inst right  chip_cell  -   450    0

# ── Derive busterms (all three levels) ────────────────────
derive_busterms 2

# ── Populate floorplan with blocks at all routing levels ───
# depth-0 blocks: needed by D0 cross-chip topology candidates
# depth-1 blocks: needed by D1 intra-chip topology candidates
# depth-2 blocks: needed by D2 intra-blk expanded candidates
add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip
add_blocks_from_bdb 2 skip

# ── Buses (written to BDB) ─────────────────────────────────
bdb_net_mode on

# Depth-0 cross-chip buses
add_bus x_top[4]   left/top/hi.out   right/top/lo.in
add_bus x_bot[4]   left/bot/hi.out   right/bot/lo.in

# Depth-1 intra-left bus (connects top-half to bot-half)
add_bus l_tb[4]    left/top/lo.out   left/bot/hi.in

# Depth-2 intra-blk bus (lo → hi within a blk instance)
# Written for the left/top blk; hier bundler detects the same
# pattern in all 4 blk instances and groups them.
add_bus b_lohi_lt[4]  left/top/lo.out    left/top/hi.in
add_bus b_lohi_lb[4]  left/bot/lo.out    left/bot/hi.in
add_bus b_lohi_rt[4]  right/top/lo.out   right/top/hi.in
add_bus b_lohi_rb[4]  right/bot/lo.out   right/bot/hi.in

# ── HBundle pipeline ───────────────────────────────────────
# Phase C: bundle at three levels
run_hier_bundler depth 2

# Phase D: generate candidates at each level
generate_hier_topologies

# Phase E: depth-0 first, then depth-1, then depth-2;
#          constraint-first within each depth
run_planner hier 5

# Abstract track placement
run_nuts

check_connectivity nuts

run_detailed_nuts
check_connectivity dnuts

visualize