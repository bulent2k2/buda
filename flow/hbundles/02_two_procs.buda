# ============================================================
# hbundles/02_two_procs.buda
#
# Multiple-occurrence test: the same proc_cell is instantiated
# twice (proc_a and proc_b) on two parallel pipeline lanes.
#
# Design (two independent lanes):
#
#   src_a  →  proc_a  →  snk_a     (upper lane, y ≈  50)
#   src_b  →  proc_b  →  snk_b     (lower lane, y ≈ 350)
#
#   Both proc_a and proc_b are instances of proc_cell, which
#   contains 3 pipe_cell stages (pa_i, pb_i, pc_i).
#
# Expected behaviour (key Phase C / D / E properties):
#
#   run_hier_bundler depth 1:
#     · 4 depth-0 cross-block HBundles
#         s2p_a  src_a→proc_a
#         p2s_a  proc_a→snk_a
#         s2p_b  src_b→proc_b
#         p2s_b  proc_b→snk_b
#     · 2 depth-1 cell-level HBundles (multiple-occurrence)
#         pa_pb  cell_context=proc_cell  instances=[proc_a, proc_b]
#         pb_pc  cell_context=proc_cell  instances=[proc_a, proc_b]
#
#   generate_hier_topologies:
#     · pa_pb and pb_pc share ONE set of candidates generated in
#       cell-local coordinates (origin at proc cell lower-left).
#
#   run_planner hier 5:
#     · Expands each cell-level wrapper into 2 per-instance wrappers:
#         pa_pb_a  (candidates offset by proc_a position)
#         pa_pb_b  (candidates offset by proc_b position)
#         pb_pc_a  (candidates offset by proc_a position)
#         pb_pc_b  (candidates offset by proc_b position)
#     · Each expanded wrapper gets a unique HBundle ID (no ID collision).
#     · Total bundles after expansion: 8 (4 cross-block + 4 expanded).
# ============================================================

source ../tracks.buda

corner_margin dx 5 dy 5
set_min_stub_length 2

# ── BDB: cell sizes ────────────────────────────────────────
open_bdb :memory:

add_cell src_cell    200 200
add_cell proc_cell   420 200
add_cell snk_cell    200 200
add_cell gen_cell     80  80
add_cell buf_cell     80  80
add_cell pipe_cell   110  80
add_cell rcv_cell     80  80
add_cell store_cell   80  80

# ── BDB: cell hierarchy ────────────────────────────────────
add_inst_to_cell src_cell  gen_i    gen_cell    20  60
add_inst_to_cell src_cell  buf_i    buf_cell   100  60

add_inst_to_cell proc_cell pa_i     pipe_cell   20  60
add_inst_to_cell proc_cell pb_i     pipe_cell  155  60
add_inst_to_cell proc_cell pc_i     pipe_cell  290  60

add_inst_to_cell snk_cell  rcv_i    rcv_cell    20  60
add_inst_to_cell snk_cell  store_i  store_cell 100  60

# ── BDB: place top-level instances (two lanes) ────────────
#   Upper lane (y=50):  src_a  proc_a  snk_a
#   Lower lane (y=350): src_b  proc_b  snk_b

add_inst src_a   src_cell  -    50   50
add_inst proc_a  proc_cell -   350   50
add_inst snk_a   snk_cell  -   870   50

add_inst src_b   src_cell  -    50  350
add_inst proc_b  proc_cell -   350  350
add_inst snk_b   snk_cell  -   870  350

# ── Derive busterms (depth 0 and 1) ───────────────────────
derive_busterms 1

# ── Populate floorplan with blocks at all routing levels ───
add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip

# ── Buses (written to BDB) ─────────────────────────────────
bdb_net_mode on

# Upper lane
add_bus s2p_a[8]    src_a/buf_i.out    proc_a/pa_i.in
add_bus pa_pb_a[8]  proc_a/pa_i.out   proc_a/pb_i.in
add_bus pb_pc_a[8]  proc_a/pb_i.out   proc_a/pc_i.in
add_bus p2s_a[8]    proc_a/pc_i.out   snk_a/rcv_i.in

# Lower lane
add_bus s2p_b[8]    src_b/buf_i.out    proc_b/pa_i.in
add_bus pa_pb_b[8]  proc_b/pa_i.out   proc_b/pb_i.in
add_bus pb_pc_b[8]  proc_b/pb_i.out   proc_b/pc_i.in
add_bus p2s_b[8]    proc_b/pc_i.out   snk_b/rcv_i.in

# ── HBundle pipeline ───────────────────────────────────────
# Phase C: detect pa_pb and pb_pc as shared cell-level bundles
#          with instances=[proc_a, proc_b]
run_hier_bundler depth 1

# Phase D: generate cell-local candidates for pa_pb and pb_pc once;
#          generate absolute candidates for all 4 cross-block bundles
generate_hier_topologies

# Phase E: expand the 2 cell-level templates into 4 per-instance
#          wrappers, each with unique bundle IDs;
#          route depth-0 bundles before depth-1
run_planner hier 5

# Abstract track placement
run_nuts

check_connectivity nuts
