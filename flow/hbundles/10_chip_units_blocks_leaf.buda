add_bus xl_u2b[4]  right/u1.out  right/u6/bb.in           # unit->blk   intra-chip
add_bus xl_b2u[4]  left/u8/bb.out  left/u7.in             # blk->unit   intra-chip
add_bus xl_c2u[4]  right.out  left/u5.in                  # chip->unit  cross-chip
add_bus xl_uu[4]  left/u6.out  right/u6.in                # unit->unit  cross-chip (unit-level pins)

# ── HBundle pipeline ───────────────────────────────────────
run_hier_bundler depth 3

generate_hier_topologies

check_design topo

run_planner hier 5

run_nuts

check_design nuts

run_detailed_nuts
check_design dnuts

visualize
