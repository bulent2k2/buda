# ============================================================
# hbundles/09_local_global_compete.buda
#
# Local/global competition: a wide cell-local bus (D1) and a global
# cross-chip bus (D0) both want the band over the cell interior.
#
#   gsrc (0,0)-(150,600)        gdst (850,0)-(1000,600)
#   proc = proc_cell @ (300,200), 400x250 -> abs (300,200)-(700,450)
#     lo  (20,40)-(120,210) cell-local -> abs (320,240)-(420,410)
#     hi (280,40)-(380,210) cell-local -> abs (580,240)-(680,410)
#
# Bands (y): [0,200] [200,240] [240,410] [410,450] [450,600]
#   local  loc[32]: eff 136 on M6 — fits ONLY band [240,410] (cap 170)
#   global g[24]:   eff 102 on M6 — fits [0,200], [240,410], or [450,600]
#
# The global is planned first (D0) and its window centre lands in
# [240,410] — without the demand reservation it takes the local's only
# band and the local must rip it up afterwards.  With the reservation
# (parked when run_planner hier expands the cell bundle), the global
# sees the cell interior as spoken for and picks [0,200] directly:
# no rip-up, everything overflow-free in one pass.
# ============================================================

source ../tracks.buda

# ── BDB: cells and hierarchy ───────────────────────────────
open_bdb :memory:

add_cell gend_cell  150 600
add_cell proc_cell  400 250
add_cell leaf_cell  100 170

add_inst_to_cell  proc_cell  lo  leaf_cell   20  40
add_inst_to_cell  proc_cell  hi  leaf_cell  280  40

add_inst gsrc  gend_cell  -    0    0
add_inst gdst  gend_cell  -  850    0
add_inst proc  proc_cell  -  300  200

derive_busterms 1

add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip

# ── Buses ──────────────────────────────────────────────────
bdb_net_mode on

# Global cross-chip bus (D0) — crosses over the proc cell.
add_bus g[24]    gsrc.out  gdst.in

# Wide cell-local bus (D1) — confined to the proc interior.
add_bus loc[32]  proc/lo.out  proc/hi.in

# ── HBundle pipeline ───────────────────────────────────────
run_hier_bundler depth 1

generate_hier_topologies

run_planner hier 5

run_nuts

check_connectivity nuts

run_detailed_nuts
check_connectivity dnuts
