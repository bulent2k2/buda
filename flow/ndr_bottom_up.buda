# NDR x BOTTOM-UP composition vehicle (requirement R13).
#
# A cell-level template governed by an NDR rule is marked set_bottom_up:
# its cell-local interconnect is planned and DNUTS-solved ONCE on the
# reference instance, then COPIED verbatim to every sibling — and the
# requirement says "shield wires included".  This vehicle is the only
# place that claim is exercised end to end:
#
#   sub_cell  4 congruent instances, marked bottom-up.  Its cell-local
#             `loc_*` bus is governed by `locsh` (width x1.5, spacing
#             x1.5, flank-the-bus GND shields) — so the reference solve
#             emits 2 shield wires per governed segment and each copy
#             must carry them too, at its own instance's coordinates.
#   top2x     a governed TOP-level bus (width x2, shield bit) planned
#             around the frozen copies — the copies are keepouts for it.
#   tdef      ungoverned top-level traffic, for contrast.
#
# align_bottom_up runs first so every instance shares a track phase (else
# check_template_tracks stops DNUTS with a mismatch report).
#
# What must hold at the end: check_template_tracks reports the class
# ALIGNED, DNUTS reports "reference bit(s) solved once ... copied to N
# sibling instance(s)", every instance carries its shields, the unplaced
# count is honest (shield rows are NOT signal bits — the accounting bug
# this vehicle was written to catch), and check_design is clean.

corner_margin dx 5 dy 5
set_min_stub_length 2

open_bdb :memory:

add_cell sub_cell  200 150
add_cell leaf_cell  60  50

add_inst_to_cell sub_cell l leaf_cell  20 50
add_inst_to_cell sub_cell r leaf_cell 120 50

# 2x2 grid.  The instances are congruent (same cell, same orientation);
# align_bottom_up nudges them onto a common track phase.
add_inst u1 sub_cell -  50  50
add_inst u2 sub_cell - 500  50
add_inst u3 sub_cell -  50 500
add_inst u4 sub_cell - 500 500

def_layer 3 M3 H 20
def_layer 4 M4 V 20
def_layer 5 M5 H TOP 20
def_layer 6 M6 V TOP 20

def_track_pattern 3 0 VDD 2 1 (_ 1 1)x12 GND 2 1
def_track_pattern 4 0 VDD 2 1 (_ 1 1)x12 GND 2 1
def_track_pattern 5 0 VDD 2 1 (_ 1 1)x12 GND 2 1
def_track_pattern 6 0 VDD 2 1 (_ 1 1)x12 GND 2 1

# Solve the cell's own interconnect once and copy it to every instance.
set_bottom_up sub_cell
align_bottom_up

derive_busterms 1

add_blocks_from_bdb 0
add_blocks_from_bdb 1 skip

bdb_net_mode on

# Cell-local bus per instance -> one sub_cell template + 3 replicas.
add_bus loc_u1[4] u1/l.out u1/r.in
add_bus loc_u2[4] u2/l.out u2/r.in
add_bus loc_u3[4] u3/l.out u3/r.in
add_bus loc_u4[4] u4/l.out u4/r.in

# Top-level buses: one governed, one not.
add_bus t2x[4]  u1/r.out u2/l.in
add_bus tdef[6] u1/r.out u3/l.in

def_ndr locsh width x1.5 spacing x1.5 shield bus net GND
def_ndr top2x width x2 shield bit net VSS
set_ndr loc_ locsh
set_ndr t2x_ top2x

run_hier_bundler depth 1
dump_ndr

generate_hier_topologies
set_track_pitch 3
run_planner hier signal_tracks

run_nuts
# The uniformity gate: every instance must see the same track pools for
# the routing it is about to be handed.
check_template_tracks on_mismatch independent
run_detailed_nuts
dump_ndr
check_design
report_wirelength
#visualize
