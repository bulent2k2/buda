# The block-side handoff on the phase-0 toy: BUDA writes the pin-DEF template
# that `reg32/gen_pins_def.py` wrote by hand (docs/internal/librelane_hier_flow.md
# §8 step 3b).  Imports the phase-0 top as placed, routes the `mid[*]` bus
# between the two reg32 macros, and emits ONE template for the reg32 CELL
# from what its two instances route: d where the bus enters u1, q where it
# leaves u0, clk/rst spread on the south edge.
#
#   python3 prep_pins.py            # after §8 steps 2 and 4; writes the three inputs below
#   bin/buda flow/librelane/phase0/two_reg32/pins.buda
#
# A pass ends in a `[PinDEF] reg32_pins.def: 66 pin(s) for reg32 — 64 from
# the plan (detailed; E 32, W 32), 2 spread on edge S on met2` line and a
# clean `check_design dnuts`; the template then goes into
# reg32/config_buda_pins.json (FP_DEF_TEMPLATE) and tools/pin_def_verify.py
# checks the hardened block against it.  What the numbers mean and what to
# record is in §8 step 3b.
#
# The tree has no EDA tools, so this was authored, not run: every input is
# a run output and `require_file` names the step that produces it.

require_file two_reg32_fp.def reg32_macro.lef sky130_tech.lef hint Run docs/internal/librelane_hier_flow.md §8 steps 2 and 4, then:  python3 flow/librelane/phase0/two_reg32/prep_pins.py

open_bdb :memory:
set_import_scale dbu
set_unit_check on

# sky130A's routing stack, declared by hand the way flow/ariane133 declares
# NanGate45: identity and direction here; PITCH/WIDTH from the tech LEF the
# run resolved; track POSITIONS from the DEF's own TRACKS.  met3..met5 are
# TOP (the metal above the LOW pair a leaf footprint blocks); the toy's one
# trunk seats on met3, the block's IO_PIN_H_LAYER, since a 32-bit bus at
# met5's 3.4 um pitch is wider than the 80 um macro face.  li1 is not
# declared (its trailing digit would collide with met1's id), so the DEF's
# li1 TRACKS are reported skipped (BUDA-1604, twice) — expected.
def_layer 1 met1 H LOW 30
def_layer 2 met2 V LOW 30
def_layer 3 met3 H TOP 30
def_layer 4 met4 V TOP 30
def_layer 5 met5 H TOP 30

# THE BUS TAKES EVERY SECOND met3 TRACK, not every one.  The global router
# is handed `GRT_LAYER_ADJUSTMENTS`, a fraction of each layer's tracks it
# keeps in reserve; a template whose 32 bits sit on 32 CONSECUTIVE tracks
# leaves it nothing on the face it has to route to, and the run ends in
# GRT-0116 overflow.  So the bus is planned at twice the PDK pitch: one
# SIGNAL slot, then one the router keeps.  The pins land on the SIGNAL
# slots, and DNUTS places the bit-wires on the same ones by construction.
#
# THE ORIGIN IS A SLOT START, NOT A TRACK CENTRE.  `def_track_pattern`'s
# origin anchors the first slot's LOW EDGE and the track is its centre, so a
# centre at c needs origin c - width/2 — which is exactly what the DEF
# importer computes for itself (`_apply_def_tracks`: `origin = tr.start -
# width/2`, since a DEF `TRACKS` start IS a centre).  sky130's met3 tracks
# are at 340 + 680k DBU, so an origin of 190 puts the signal centres on
# 340 + 1360k: every second PDK track, starting at the first.  Measured
# here with the engine's own `TrackPattern`, both values:
#
#   origin 190  ->  unit_pitch 1360, signal centres 340, 1700, 3060, ...
#   origin 340  ->  unit_pitch 1360, signal centres 490, 1850, 3210, ...
#
# The end-to-end run recorded in §8 step 3b used 340 — 150 DBU (0.15 um)
# off every PDK met3 track, half the wire width — and still hardened
# cleanly (66/66 pins verified) with 4 residual overflow at the die margin.
# 190 is the on-track value and is what is declared here; RE-MEASURE before
# quoting a new wirelength, and `340` reproduces the recorded run exactly.
#
# The instance origins below stay on the period either way: the phase rule
# reads the pattern's `unit_pitch`, which this doubles to 1360, and
# 20400 = 15 x 1360.
def_track_pattern 3 190 SIGNAL 300 380 CUSTOM 300 380

import_lef_tech sky130_tech.lef

# The top as LibreLane placed it: u0 at (10, 20) um, u1 at (160, 20) um on a
# 250 x 120 um die — the PDN-phase-safe placement §8 step 4 arrived at.
import_def_lef two_reg32_fp.def reg32_macro.lef

# ... moved onto the TRACK PERIOD.  The block is hardened alone with tracks
# at OFFSET + k*PITCH from ITS origin, so a pin taken from the top's routed
# wire is on the block's grid only when the instance origin is a whole
# number of periods on the pin layer: x on met2 (0.46 um), y on met3 (1.36
# with the doubled pattern above, 0.68 without it).  (10, 20) is 0.34 past
# a met2 period and 0.28 past a met3 one — measured on this toy, d[0] lands
# 0.40 um off the block's met3 track and clk 0.12 off met2 — and
# `emit_pin_def` refuses it (or, with `snap`, moves every pin and says by
# how much).  9.2 / 160.08 are the nearest multiples of 0.46 that keep both
# macros clear of the 30 um PDN straps (VGND met4 pin at cell-local
# 13.22..15.22 against straps at 5.52 + 30k, width 1.6); 20.4 is a whole
# number of BOTH met3 periods, so it stands whichever pattern is declared.
# Step 3b carries these into the top's MACROS locations for the re-run.
move_comp u0 9200 20400
move_comp u1 160080 20400

derive_busterms
add_blocks_from_bdb 0
run_hier_bundler
dump_hbundles

generate_hier_topologies
run_planner hier 3
run_nuts
check_design nuts
run_detailed_nuts
check_design dnuts
report_wirelength

# 66 pins: 32 d (W face, met3, from u1), 32 q (E face, met3, from u0), clk +
# rst on the S edge on met2 tracks — every one on the BLOCK's own track
# grid (no `snap`, nothing reported snapped).  UNITS 1000 (dbu), DIEAREA
# 80000 x 80000.
emit_pin_def reg32_pins.def reg32 unrouted S met2
