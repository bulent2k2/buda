VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN chip ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 260000 90000 ) ;

TRACKS X 190 DO 1368 STEP 190 LAYER M1 ;
TRACKS Y 190 DO 473 STEP 190 LAYER M1 ;
TRACKS X 200 DO 1300 STEP 200 LAYER M2 ;
TRACKS Y 200 DO 450 STEP 200 LAYER M2 ;
TRACKS X 200 DO 1300 STEP 200 LAYER M3 ;
TRACKS Y 200 DO 450 STEP 200 LAYER M3 ;
TRACKS X 400 DO 650 STEP 400 LAYER M4 ;
TRACKS Y 400 DO 225 STEP 400 LAYER M4 ;
TRACKS X 400 DO 650 STEP 400 LAYER M5 ;
TRACKS Y 400 DO 225 STEP 400 LAYER M5 ;
TRACKS X 800 DO 325 STEP 800 LAYER M6 ;
TRACKS Y 800 DO 112 STEP 800 LAYER M6 ;

GCELLGRID X 0 DO 27 STEP 10000 ;
GCELLGRID Y 0 DO 10 STEP 10000 ;

COMPONENTS 8 ;
  - u_q0/bl/hi
      LEAF
      + PLACED ( 60000 10000 ) N ;
  - u_q0/bl/lo
      LEAF
      + PLACED ( 10000 10000 ) N ;
  - u_q0/br/hi
      LEAF
      + PLACED ( 60000 55000 ) N ;
  - u_q0/br/lo
      LEAF
      + PLACED ( 10000 55000 ) N ;
  - u_q1/bl/hi
      LEAF
      + PLACED ( 210000 10000 ) N ;
  - u_q1/bl/lo
      LEAF
      + PLACED ( 160000 10000 ) N ;
  - u_q1/br/hi
      LEAF
      + PLACED ( 210000 55000 ) N ;
  - u_q1/br/lo
      LEAF
      + PLACED ( 160000 55000 ) N ;
END COMPONENTS

PINS 8 ;
  - din[0] + NET din[0] + DIRECTION INPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 500 14000 ) N ;
  - din[1] + NET din[1] + DIRECTION INPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 500 19000 ) N ;
  - din[2] + NET din[2] + DIRECTION INPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 500 24000 ) N ;
  - din[3] + NET din[3] + DIRECTION INPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 500 29000 ) N ;
  - dout[0] + NET dout[0] + DIRECTION OUTPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 259500 59000 ) N ;
  - dout[1] + NET dout[1] + DIRECTION OUTPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 259500 64000 ) N ;
  - dout[2] + NET dout[2] + DIRECTION OUTPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 259500 69000 ) N ;
  - dout[3] + NET dout[3] + DIRECTION OUTPUT + USE SIGNAL
      + LAYER M2 ( -250 -250 ) ( 250 250 )
      + PLACED ( 259500 74000 ) N ;
END PINS

BLOCKAGES 2 ;
  - LAYER M4 RECT ( 110000 30000 ) ( 150000 60000 ) ;
  - PLACEMENT RECT ( 110000 0 ) ( 150000 10000 ) ;
END BLOCKAGES

SPECIALNETS 2 ;
  - VDD ( * VDD ) + ROUTED M6 2000 ( 30000 5000 ) ( * 85000 )
      NEW M6 2000 ( 230000 5000 ) ( * 85000 ) + USE POWER ;
  - VSS ( * VSS ) + ROUTED M6 2000 ( 130000 5000 ) ( * 85000 ) + USE GROUND ;
END SPECIALNETS

NETS 36 ;
  - din[0] ( PIN din[0] ) ( u_q0/bl/lo A[0] ) + USE SIGNAL ;
  - dout[0] ( u_q1/br/hi Z[0] ) ( PIN dout[0] ) + USE SIGNAL ;
  - c[0] ( u_q0/br/hi Z[0] ) ( u_q1/bl/lo A[0] ) + USE SIGNAL ;
  - din[1] ( PIN din[1] ) ( u_q0/bl/lo A[1] ) + USE SIGNAL ;
  - dout[1] ( u_q1/br/hi Z[1] ) ( PIN dout[1] ) + USE SIGNAL ;
  - c[1] ( u_q0/br/hi Z[1] ) ( u_q1/bl/lo A[1] ) + USE SIGNAL ;
  - din[2] ( PIN din[2] ) ( u_q0/bl/lo A[2] ) + USE SIGNAL ;
  - dout[2] ( u_q1/br/hi Z[2] ) ( PIN dout[2] ) + USE SIGNAL ;
  - c[2] ( u_q0/br/hi Z[2] ) ( u_q1/bl/lo A[2] ) + USE SIGNAL ;
  - din[3] ( PIN din[3] ) ( u_q0/bl/lo A[3] ) + USE SIGNAL ;
  - dout[3] ( u_q1/br/hi Z[3] ) ( PIN dout[3] ) + USE SIGNAL ;
  - c[3] ( u_q0/br/hi Z[3] ) ( u_q1/bl/lo A[3] ) + USE SIGNAL ;
  - u_q0/m[0] ( u_q0/bl/hi Z[0] ) ( u_q0/br/lo A[0] ) + USE SIGNAL ;
  - u_q0/m[1] ( u_q0/bl/hi Z[1] ) ( u_q0/br/lo A[1] ) + USE SIGNAL ;
  - u_q0/m[2] ( u_q0/bl/hi Z[2] ) ( u_q0/br/lo A[2] ) + USE SIGNAL ;
  - u_q0/m[3] ( u_q0/bl/hi Z[3] ) ( u_q0/br/lo A[3] ) + USE SIGNAL ;
  - u_q0/bl/w[0] ( u_q0/bl/lo Z[0] ) ( u_q0/bl/hi A[0] ) + USE SIGNAL ;
  - u_q0/bl/w[1] ( u_q0/bl/lo Z[1] ) ( u_q0/bl/hi A[1] ) + USE SIGNAL ;
  - u_q0/bl/w[2] ( u_q0/bl/lo Z[2] ) ( u_q0/bl/hi A[2] ) + USE SIGNAL ;
  - u_q0/bl/w[3] ( u_q0/bl/lo Z[3] ) ( u_q0/bl/hi A[3] ) + USE SIGNAL ;
  - u_q0/br/w[0] ( u_q0/br/lo Z[0] ) ( u_q0/br/hi A[0] ) + USE SIGNAL ;
  - u_q0/br/w[1] ( u_q0/br/lo Z[1] ) ( u_q0/br/hi A[1] ) + USE SIGNAL ;
  - u_q0/br/w[2] ( u_q0/br/lo Z[2] ) ( u_q0/br/hi A[2] ) + USE SIGNAL ;
  - u_q0/br/w[3] ( u_q0/br/lo Z[3] ) ( u_q0/br/hi A[3] ) + USE SIGNAL ;
  - u_q1/m[0] ( u_q1/bl/hi Z[0] ) ( u_q1/br/lo A[0] ) + USE SIGNAL ;
  - u_q1/m[1] ( u_q1/bl/hi Z[1] ) ( u_q1/br/lo A[1] ) + USE SIGNAL ;
  - u_q1/m[2] ( u_q1/bl/hi Z[2] ) ( u_q1/br/lo A[2] ) + USE SIGNAL ;
  - u_q1/m[3] ( u_q1/bl/hi Z[3] ) ( u_q1/br/lo A[3] ) + USE SIGNAL ;
  - u_q1/bl/w[0] ( u_q1/bl/lo Z[0] ) ( u_q1/bl/hi A[0] ) + USE SIGNAL ;
  - u_q1/bl/w[1] ( u_q1/bl/lo Z[1] ) ( u_q1/bl/hi A[1] ) + USE SIGNAL ;
  - u_q1/bl/w[2] ( u_q1/bl/lo Z[2] ) ( u_q1/bl/hi A[2] ) + USE SIGNAL ;
  - u_q1/bl/w[3] ( u_q1/bl/lo Z[3] ) ( u_q1/bl/hi A[3] ) + USE SIGNAL ;
  - u_q1/br/w[0] ( u_q1/br/lo Z[0] ) ( u_q1/br/hi A[0] ) + USE SIGNAL ;
  - u_q1/br/w[1] ( u_q1/br/lo Z[1] ) ( u_q1/br/hi A[1] ) + USE SIGNAL ;
  - u_q1/br/w[2] ( u_q1/br/lo Z[2] ) ( u_q1/br/hi A[2] ) + USE SIGNAL ;
  - u_q1/br/w[3] ( u_q1/br/lo Z[3] ) ( u_q1/br/hi A[3] ) + USE SIGNAL ;
END NETS

END DESIGN
