# from big_3bundles_sel_pure_mst_topo.buda
# cloned all 3 to swap HV / VH
source ../tracks/tracks4top.buda
source tc3a_flat_x10_blocks.buda

add_bus bus_030[128] blk_29.p blk_22.p,blk_08.p,blk_14.p,blk_18.p    # --- bundle 5 (was 57)
add_bus bus_047[128] blk_27.p blk_36.p,blk_11.p,blk_26.p             # --- bundle 4 (was 50)
add_bus bus_069[64]  blk_25.p blk_21.p,blk_27.p,blk_18.p,io_pad_tl.p # --- bundle 3 (was 46)
add_bus sub_030[128] blk_22.p blk_29.p,blk_08.p,blk_14.p,blk_18.p    # --- bundle 2
add_bus sub_047[128] blk_36.p blk_27.p,blk_11.p,blk_26.p             # --- bundle 6
add_bus sub_069[64]  blk_21.p blk_25.p,blk_27.p,blk_18.p,io_pad_tl.p # --- bundle 1

run_bundler
generate_topologies
dump_topologies --grouped

# BTW: MST_HV or MST_VH has no locus variant (because there is no trunk), so group prefix is redundant
#                                   # bundle   MST family    (rep type @ candidate id)
select_topology  bus_069  group:16  # bus_069  MST_HV @ 16   (MST_VH @ 17)
select_topology  bus_047  group:23  # bus_047  MST_VH @ 23   (MST_HV @ 26)
select_topology  bus_030  group:19  # bus_030  MST_HV @ 19   (MST_VH @ 20)

select_topology  sub_069  17  # MST_VH Aside: topo display has an open for many TRUNK_H families
select_topology  sub_047  26  # MST_HV
select_topology  sub_030  20  # MST_VH

run_planner
run_nuts
check_design nuts
run_detailed_nuts
check_design
visualize
