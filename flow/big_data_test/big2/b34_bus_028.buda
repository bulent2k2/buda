# three abuted blocks. Trunk contained in its passthru block.
# we should not force it to connect to a block edge, but ensure that it doesn't slide out.
# how to do it?

# source tc3b_flat_x5.buda
add_block blk_00 1250 3780 2230 4775
add_block blk_15 2230 3365 3500 4615
add_block blk_32 2230 4615 3500 5350
add_bus bus_028[28] blk_15.p blk_32.p,blk_00.p

run_bundler
generate_topologies
select_topology 1 2
dump_topologies --conn
source tracks4top.buda
run_planner
run_nuts
run_detailed_nuts
check_design
#visualize
