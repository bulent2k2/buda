# From big2_b4_b24.buda
source tracks4top.buda

set_die 6100 6300
add_block blk_09 3500 2570 4870 3100
add_block blk_14 2230 2720 3500 3365
add_block blk_19 0 2660 1250 3310
add_block blk_39 4870 3365 6100 4425

# --- bundle 24 (bus_056)
add_bus bus_056[48] blk_09.p blk_14.p,blk_39.p,blk_19.p

run_bundler
generate_topologies

# Pin the exact topologies that were buggy in the full big2.buda run, now fixed:
#   bundle (b24)=TRUNK_V@x5485 (topo 8) — generation used to leave blk_09 uncovered
#                                            (fixed: coverage-safe stub suppression).
# The TRUNK_V candidate index moved (4->8) once blk_09's stub is no longer dropped.
select_topology 1 8
# Check the SELECTED topologies before planning so a topology-gen coverage gap
# (bundle 24 / blk_09) is caught at the topo stage and can't be masked by a later
# NUTS/DNUTS change. Bundle 4's detach is a NUTS-stage artifact (clean at topo).
check_connectivity topo
dump_topologies --conn
run_planner
dump_topologies --conn
run_nuts
check_connectivity nuts
run_detailed_nuts
check_connectivity
visualize
exit
