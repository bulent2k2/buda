# copied over from tc3b_flat.buda (used to be a soft-link)
source tracks4top.buda
source tc3b_flat_x5.buda
run_bundler
# nuts: 10 overlaps, dnuts: 168 opens
#generate_topologies double_detour
# nuts: 6 overlaps,  dnuts: 52
generate_topologies
check_design topo all
# This flow heals (ripup_reroute/negotiate_congestion below), so opt into the
# kSegsRel proactive default explicitly (issue #444 — replaces the old
# script-text lookahead so source/line-by-line/interactive all agree).
set_planner_param healersAhead 1
run_planner signal_tracks
run_nuts
negotiate_congestion
# overlaps 2->0, but has no impact on DNUTS
ripup_reroute
check_design nuts
run_detailed_nuts
negotiate_congestion
# no help:
# ripup_reroute
check_design
visualize
