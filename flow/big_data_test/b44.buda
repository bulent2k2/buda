source ../tracks/tracks4top.buda
#source tc3a_flat_x10.buda

add_block blk_07 2960 9750 4660 10250
add_block blk_23 200 10830 2700 11830
add_block io_pad_tl 200 12000 1200 12800

add_bus bus_060[52] blk_23.p blk_07.p,io_pad_tl.p

run_bundler
generate_topologies
check_design topo all

# planner selects the first topo: trunk+mst topo (topo WL = 3510)
# select_topology 1 1
run_planner
run_nuts
run_detailed_nuts
check_design
report_wl
# [report_wirelength] total detailed WL = 234546 over 1 bundle(s) / 312 bit-wire(s), 0 unplaced bit(s); bit-scaled envelope [182520..632320]
# visualize

# simple L-topo comes much later (topo WL = 4010; TRUNK_V@x700 — the
# structural (wl, nsegs, type) tie-break sorts this 2-seg candidate ahead
# of its 4010-tie siblings, so it sits at index 8 now, not 10)
select_topology 1 8
run_planner
run_nuts
run_detailed_nuts
check_design
report_wl
# [report_wirelength] total detailed WL = 193376 over 1 bundle(s) / 104 bit-wire(s), 0 unplaced bit(s); bit-scaled envelope [182520..260520]
# visualize

# The fix: `set_planner_param kWLSpread 0.125` (opt-in) prices realization
# risk — scored WL = nominal + kWLSpread*(wl_hi - wl_lo), the candidate's
# slide/span DOF envelope — so the wide-envelope trunk+mst (spread 8650) is
# demoted and the planner UN-pinned picks an even better candidate than the
# hand-pin above (detailed WL 188513, -19.6% vs the default's 234546).
# See docs/script_reference/planner.md (kWLSpread) and
# test/tests/test_planner_wl_spread.py.
# set_planner_param kWLSpread 0.125
