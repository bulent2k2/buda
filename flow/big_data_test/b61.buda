# 6 busterms, ideal topo: trunk V + trunk H + one stub
# instead of the 10 seg Trunk+MST
# let's measure the impact of a num-seg penalty..

source ../tracks/tracks4top.buda
#source tc3a_flat_x10.buda

add_block blk_01 10680 2310 13580 3310
add_block blk_22 11380 4970 13580 6870
add_block blk_24 9250 7990 10950 9090
add_block blk_29 11580 3780 13580 4680
add_block blk_31 200 7990 2700 9190
add_block blk_32 4870 9430 7470 10630

add_bus bus_034[16] blk_32.p blk_01.p,blk_29.p,blk_22.p,blk_24.p,blk_31.p

run_bundler
generate_topologies
check_design topo all

# planner selects the first topo (1 of 29 or 30): trunk-h
# select_topology 1 1
run_planner
run_nuts
run_detailed_nuts
check_design
report_wl
visualize
