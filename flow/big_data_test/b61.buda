# 6 busterms, ideal topo: trunk V + trunk H + one stub
# instead of the 10 seg Trunk+MST
# let's measure the impact of a num-seg penalty..
#
# FINDINGS (kSegs experiment — set_planner_param kSegs <wl-units/segment>):
#   pinned through planner+NUTS+DNUTS (all clean, 16-bit bus):
#     topo1  TRUNK_H+MST 10 segs estWL 15940  detWL 244772  vias 144
#     topo13 TRUNK_V+MST  5 segs estWL 17480  detWL 250064  vias  64
#     topo19 TRUNK_V      4 segs estWL 19010  detWL 303436  vias  48
#     topo26 TRUNK_V      3 segs estWL 21110  detWL 307268  vias  32
#   the WL estimate exaggerates the big tree's edge (+9.7% est vs +2.2%
#   realized against the 5-seg tree, which has 56% fewer per-bit vias).
#   kSegs selects: 0->topo1, 100-300->topo2 (9 segs), 400-800->topo13,
#   1600->topo19, 2400->topo26 (the 3-seg shape described above).
#   corpus @500: big2 unplaced 108->0, overlaps 4->0, detWL +1.8%;
#   bigHalf unplaced 593->214, overlaps 3->1, detWL -3.1%, vias -29%.
# uncomment to try:
#set_planner_param kSegs 500

source ../tracks/tracks4top.buda
#source tc3a_flat_x10.buda

add_block blk_01 10680 2310 13580 3310
add_block blk_22 11380 4970 13580 6870
add_block blk_24 9250 7990 10950 9090
add_block blk_29 11580 3780 13580 4680
add_block blk_31 200 7990 2700 9190
add_block blk_32 4870 9430 7470 10630

add_bus bus_034[16] blk_32.p blk_01.p,blk_29.p,blk_22.p,blk_24.p,blk_31.p

run_bundler
generate_topologies
check_design topo all

# planner selects the first topo (1 of 29 or 30): trunk-h
# select_topology 1 1
run_planner
run_nuts
run_detailed_nuts
check_design
report_wl
visualize
