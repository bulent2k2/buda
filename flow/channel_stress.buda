# channel_stress.buda
# 8 top blocks + 8 bottom blocks with a 340-unit horizontal channel.
# 200 nets randomly paired (fixed seed=42) — stress-tests NUTS channel packing.
# Results in 62 bundles.

source tracks/tracks_for_channel_stress.buda

add_block u_b0    20   20   80   80
add_block u_b1   100   20  160   80
add_block u_b2   180   20  240   80
add_block u_b3   260   20  320   80
add_block u_b4   340   20  400   80
add_block u_b5   420   20  480   80
add_block u_b6   500   20  560   80
add_block u_b7   580   20  640   80

add_block u_t0    20  420   80  480
add_block u_t1   100  420  160  480
add_block u_t2   180  420  240  480
add_block u_t3   260  420  320  480
add_block u_t4   340  420  400  480
add_block u_t5   420  420  480  480
add_block u_t6   500  420  560  480
add_block u_t7   580  420  640  480

source test4_nets.buda

run_bundler strict

# source test4_gen_topo.buda
generate_topologies

select_topologies 2,8,10,17,18,25,27,34,36,43,45,52,54,61 3
select_topologies 1,9,26,35,44,53,62 1 3-7,11-16,19-24,28-32,37-42,46,47,49-51,55,57-60 4
# Rip-up and reroute bundle 33 with a detour.  Required since the Issue #22
# congestion fix (closed-interval for_each_band counts trunk-junction arms
# honestly): bundle 33's straight route now over-subscribes the channel, so we
# pin its detour explicitly.
select_topology 33 5
# bundles 48 and 56 are free
run_planner 5
#run_nuts 2.0
run_nuts
# Overlaps: 54  (M4=1, M5=53).  All 62 bundles are crammed onto the two initial
# layers (M4/M5), so the channel is genuinely over-subscribed — these are
# congestion overlaps, not corner touches, so repair/corner passes can't clear
# them here.  The fix below is to redistribute onto more layers.

# post_nuts reassigns segment layers by stub length, spreading the channel onto
# M3 (short) and M7 (long) so it actually fits.  With these knobs (short<220,
# long>320) the split is roughly: short→M3 (~34b), medium→M5 (~18b), long→M7 (~10b).
# (The vertical channel is 400 tall; tune the two thresholds to shift the split.)
# Thresholds bumped 200/300→220/320 alongside the Issue #22 fix to keep the
# redistribution near-clean under the corrected congestion accounting.
run_planner post_nuts V 220 320

#run_nuts 2.0
run_nuts
# Overlaps: 1  (B48×B53 on M7).  The pre-redistribution run_nuts above packs the
# channel CLEANLY (0); the post_nuts stub-length spread then leaves a single
# corner overlap between free bundle 48 and pinned bundle 53.  This 62-bundle /
# 200-net channel rides on only three vertical layers (M3/M5/M7), so under the
# corrected congestion accounting (Issue #22) it sits right at its packing limit
# — one residual corner touch that no threshold/pin re-tune fully removes.
# Detailed NUTS still places every bit (0 unplaced).

# NOTE: previously this flow needed per-layer reruns to grind the overlaps down
# (run_nuts above used to leave 22, then M3→10, M5→4).  The generalized NUTS
# (corner-overlap resolution + parallel/end-to-end touch handling) now packs to 0
# in the run_nuts above, so the reruns are no-ops and are left commented out:
#run_nuts_on_layer M3   # was: 22 → 10
#run_nuts_on_layer M5   # was: 10 → 4
#run_nuts_on_layer M3   # was: no effect
check_connectivity nuts

run_detailed_nuts
check_connectivity dnuts

visualize
