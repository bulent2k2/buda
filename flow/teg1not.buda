# term equivalence group

def_layer 5 M5 V TOP 0.33
def_layer 6 M6 H TOP 0.33

corner_margin dx 20 dy 10
add_block bt1a  0 200 300 400
add_block bt1b  0 600 200 800
add_block bt2a  400 0  600 100
add_block bt2b  700 50 800 150

add_bus bus1[8] bt1a.o bt2a.i
add_bus bus2[8] bt1a.o bt1b.o,bt2a.i,bt2b.i
run_bundler strict
generate_topologies
run_planner
run_nuts
visualize
