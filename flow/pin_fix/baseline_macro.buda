# fix_pin PR 1a baseline — a macro with buses landing on three of its faces.
#
# PR 1a is a pure refactor: the floorplan now answers two questions through
# two names (`landing_rects`: where may a wire ATTACH; `obstruction_rects`:
# what does the block BLOCK) and no pin is fixed yet, so this flow routes
# exactly as it did before the split.  It is the "before" picture the fix_pin
# flows in PR 1b are compared against: same floorplan, same buses, then a
# `fix_pin` line that moves or removes landings.
#
#   west  bus  a -> MAC    (a sits left of the macro)
#   north bus  b -> MAC    (b sits above)
#   east  bus  c -> MAC    (c sits right)
#
# Run:   bin/buda flow/pin_fix/baseline_macro.buda     (opens the viewer)
#        bin/buda --no-viz flow/pin_fix/baseline_macro.buda   (headless)
# Expect: three short trunks, each landing on the macro face nearest its
# source; check_design reports Success at both stages.

add_block MAC 400 400 700 700
add_block a   0   450 150 650
add_block b   450 900 650 1000
add_block c   950 450 1100 650

def_layer 4 M4 H TOP 0
def_layer 5 M5 V TOP 0
def_track_pattern 4 0 (SIGNAL 2 2)x40
def_track_pattern 5 0 (SIGNAL 2 2)x40

add_bus wd[4] a.tx MAC.rx
add_bus nd[4] b.tx MAC.rx
add_bus ed[4] c.tx MAC.rx

run_bundler STRICT
generate_topologies
run_planner
run_nuts
check_design
run_detailed_nuts
check_design
report_wl
visualize
