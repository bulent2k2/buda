# fix_pin PR 2a — `layer`: which layer the wire that LANDS on a pin may take.
#
#   SRC (west) and TOP (above) drive MAC with three 4-bit buses; the default
#   plan puts these runs on the TOP layers (M5 horizontal, M6 vertical).
#
#     fixed_*  -> MAC.f_in  fix_pin MAC.f_in west layer M3
#                           the landing stub must be on M3, a LOW horizontal layer
#     down_*   -> MAC.b_in  fix_pin MAC.b_in north layer M4   (driven by TOP)
#                           M4 is a LOW vertical layer: the wire down onto the
#                           north face is on M4 instead of the TOP layer M6
#     free_*   -> MAC.g_in  no fix: the planner's own choice, as before
#
# A layer narrows the faces to the ones it can reach (an east or west face is
# landed on by a horizontal wire, north/south by a vertical one), and a layer
# of the wrong direction for every face asked is refused at declaration.
# `check_design` reports PIN_FIX if a wire ever lands outside its fixed layers.
#
# Run:   bin/buda flow/pin_fix/layers.buda          (viewer)
#        bin/buda --no-viz flow/pin_fix/layers.buda (headless)
# Expect: '[PinFix] ... layer M3' lines, check_design Success at both stages,
#         the fixed bus's landing stub on M3 (dump_topologies --conn shows the
#         layers once planned), the free bus on the TOP layers.

add_block SRC 0   400 100 600
add_block TOP 400 800 600 900
add_block MAC 400 400 600 600

def_layer 3 M3 H LOW 0
def_layer 4 M4 V LOW 0
def_layer 5 M5 H TOP 0
def_layer 6 M6 V TOP 0
def_track_pattern 3 0 (SIGNAL 2 2)x60
def_track_pattern 4 0 (SIGNAL 2 2)x60
def_track_pattern 5 0 (SIGNAL 2 2)x60
def_track_pattern 6 0 (SIGNAL 2 2)x60

fix_pin MAC.f_in west layer M3
fix_pin MAC.b_in north layer M4
dump_pin_fixes

add_bus fixed[4] SRC.o MAC.f_in
add_bus down[4]  TOP.o MAC.b_in
add_bus free[4]  SRC.o MAC.g_in

run_bundler STRICT
generate_topologies
run_planner
dump_topologies --conn
run_nuts
check_design
run_detailed_nuts
check_design
report_wl
visualize
