# fix_pin PR 1c — per-pin selectors: ONE macro, two buses, two different faces.
#
#   SRC (west) drives MAC with two 4-bit buses that STRICT bundling would merge
#   (same driver block, same receiver block):
#
#     lo_*  -> MAC.lo_in   fix_pin MAC.lo_in west    lands on the near face
#     hi_*  -> MAC.hi_in   fix_pin MAC.hi_in north   must come over the top
#     mid_* -> MAC.cfg_a   fix_pin MAC.cfg* south    (prefix selector) the
#                                                    bottom face
#
# A bundle lands on one face, so the bundler SPLITS the merged bundle into
# fix-uniform parts and says so ([PinFix] split ...).  Precedence, most
# specific first: exact pin > bus name > longest prefix* > block-level fix.
# The viewer draws each admissible landing as a thick green line.
#
# Run:   bin/buda flow/pin_fix/pins.buda          (viewer)
#        bin/buda --no-viz flow/pin_fix/pins.buda (headless)
# Expect: a '[PinFix] split bundle' line, check_design Success at both stages,
#         and the three buses on three different faces of MAC.

add_block SRC 0   400 100 600
add_block MAC 400 400 600 600

def_layer 4 M4 H TOP 0
def_layer 5 M5 V TOP 0
def_track_pattern 4 0 (SIGNAL 2 2)x60
def_track_pattern 5 0 (SIGNAL 2 2)x60

fix_pin MAC.lo_in west
fix_pin MAC.hi_in north
fix_pin MAC.cfg*  south
dump_pin_fixes

add_bus lo[4]  SRC.o MAC.lo_in
add_bus hi[4]  SRC.o MAC.hi_in
add_bus mid[4] SRC.o MAC.cfg_a

run_bundler STRICT
generate_topologies
dump_topologies --conn
run_planner
run_nuts
check_design
run_detailed_nuts
check_design
report_wl
visualize
