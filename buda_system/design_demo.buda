# 1. Define the Chip
add_block u_cpu  100 400 300 600
add_block u_gpu  500 400 700 600
add_block u_mem  300 100 500 200
add_block u_io   300 800 500 900

# 2. Define Tech Stack
# ID Name Dir Type Overhead
def_layer 3 M3 H TOP 25.0
def_layer 4 M4 V TOP 25.0

# 3. Define Connectivity (Simplified for demo)
# CPU to Mem (Needs Vertical path)
add_net data0 u_cpu.d0 u_mem.d0
add_net data1 u_cpu.d1 u_mem.d1
add_net data2 u_cpu.d2 u_mem.d2
add_net data3 u_cpu.d3 u_mem.d3

# GPU to Mem (Needs different path)
add_net gfx0 u_gpu.d0 u_mem.d0
add_net gfx1 u_gpu.d1 u_mem.d1

# CPU to GPU (Horizontal)
add_net coh0 u_cpu.c0 u_gpu.c0
add_net coh1 u_cpu.c1 u_gpu.c1

# 4. Run the Pipeline
run_bundler strict
run_planner 10

# 5. Show me the results
visualize