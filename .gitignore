**/*.log
**/*.so
**/*.bdb
**/*.bdb-shm
**/*.bdb-wal
# A BDB is committed as diffable SQL text (see docs/internal/bdb_test_data.md);
# rebuild the binary on demand with tools/bdb_serialize.py. Ignore the binary
# forms of the historical rename tricks (.b-db / .b_db) and their WAL sidecars,
# but always keep the .sql text tracked.
**/*.b-db
**/*.b-db-shm
**/*.b-db-wal
**/*.b_db
**/*.b_db-shm
**/*.b_db-wal
!**/*.bdb.sql
!**/*.b-db.sql
!**/*.b_db.sql
# The build trace `btcl -i`/`btcl -b` writes beside a live checkpoint: its
# name is `<ckpt>.trace`, so the `*.bdb` rule above does not reach it, and a
# durable `.sql writeback` checkpoint's trace ends `.bdb.sql.trace`
# (generalizes flow/ariane133/.gitignore's local rule).
**/*.bdb.trace
**/*.bdb.sql.trace
**/*.sqbpro
**/build/
**/__pycache__/
**/*~
.DS_Store
# macOS launcher bundles are host-specific build products; regenerate with
# tools/make_macos_apps.py (see docs/internal/macos_app_bundles.md).
bin/*.app/
flow/log/
log/
# Scala.js frontend build products (regenerate with `bb web` / `sbt fullLinkJS`,
# see web/README.md). The served bundle is a BUILD PRODUCT, not tracked — only
# the page shell src/web/static/scala/index.html is committed; `bb web` emits
# main.js next to it, git-ignored. The toolchain-free reference client at / needs
# no build.
web/target/
web/project/target/
web/project/project/
web/main.js
web/main.js.map
src/web/static/scala/main.js
src/web/static/scala/main.js.map
# Local Scala toolchain (coursier + sbt launcher), fetched per web/README.md.
.tools/
chip_designs
graphify-out
docs/.obsidian/
# Worktree-local symlink to the main checkout build/ (for pytest/uvicorn).
/build
# scikit-build-core's build tree — `pip install .` puts it here, from
# pyproject.toml's `build-dir = ".pipbuild/{wheel_tag}"`.  63 MB of build
# output, and untracked: the pip path landed without this line, so every
# checkout that has ever run `pip install .` reports a dirty tree forever.
/.pipbuild

# Windows/venv workflow (docs/WINDOWS_BUILD.md creates it in-repo)
.venv/

# flow/tcl/array_save.tcl + array_resume.tcl write their checkpoint here.
# Needs to be explicit: the `.bdb` binary is already ignored, but the
# diffable `.bdb.sql` snapshot beside it is deliberately UN-ignored above
# (checked-in BDB fixtures are text), so without this the vehicle dirties
# `git status` every time someone runs it.
flow/tcl/out/

# pip's CMake build tree (tool.scikit-build build-dir). Deliberately NOT build/,
# which is the developer tree bin/bb writes — see pyproject.toml.
.pipbuild/

# Flow copies made by test helpers.  They are written into the flow's OWN
# directory (a `source` resolves against the SCRIPT's directory, so a tmp_path
# copy would not find its includes) and unlinked in a `finally` — which does
# not run when the test process is killed, so an interrupted run leaves one
# behind.  Ignored so a stray artifact cannot be swept into a `git add -A`.
flow/**/_no_trim_*.buda
flow/**/_trunk_trim_on_*.buda
flow/**/_mst_trim_off_*.buda

# LibreLane study (docs/internal/librelane_hier_flow.md): generated designs and run dirs
flow/librelane/tier1a/n*/
flow/librelane/tier1b/n*/
flow/librelane/**/runs/
flow/librelane/phase0/measure/out/
flow/librelane/phase0/reg32/pins.def
