# ==================================================================
# BUDA Large-Scale Stress-Test Demo — FLAT variant
# 14 top blocks · 26 bundles · 4–64-bit buses · M4/M5/M6 layers
# 2-part pins (u_cpu0.tag_tx) → STRICT bundler collapses ports by
# src+dst block pair. See large_scale_demo_pseudo_hier.buda for the
# per-port hierarchy-faking variant. Generated by generate_large_demo.py.
# ==================================================================

# Layers: M4 horizontal, M5 vertical, M6 long-haul horizontal
# high power % is to force planner to resort to M6
#def_layer 2 M2 H     5.0
#def_layer 3 M3 V     10.0
#def_layer 4 M4 H TOP 10.0
#def_layer 5 M5 V TOP 20.0
#def_layer 6 M6 H TOP 20.0
#def_layer 7 M7 V TOP 20.0
#def_layer 8 M8 H     40.0
source ../flow/tracks/tracks.buda

# Floorplan blocks
add_block u_cpu0 200 200 1000 1600
add_block u_cpu1 200 2000 1000 3400
add_block u_gpu 200 3800 2000 6600
add_block u_npu 200 7000 2000 8400
add_block u_l3 2400 200 6000 3400
add_block u_noc 2400 3800 8400 6600
add_block u_hbm0 8800 200 10400 3400
add_block u_hbm1 8800 3800 10400 6600
add_block u_ddr 8800 7000 10400 8400
add_block u_disp 2400 7000 5000 8400
add_block u_isp 5600 7000 8400 8400
add_block u_pcie 2400 9000 5000 10200
add_block u_usb 5600 9000 8400 10200
add_block u_sec 8800 9000 10400 10200

source ../flow/large_scale_demo_buses.buda

# Stage 1 — bundle nets by driver+receiver instance
run_bundler strict

# Stage 2
# source large_scale_demo_gen_topo.buda
generate_topologies

# Stage 3 — congestion-aware topology selection (fattest-bus-first)
run_planner 5

# Stage 4 — NUTS abstract track placement (pitch=2.0)
#run_nuts 1.0
run_nuts

# After improvements to layer assignment in run_planner, this makes overlaps worse because many more short segs go down to M2
# V 100 280 H 150 400
# run_planner post_nuts V H
# run_nuts_on_layer M7
#run_nuts 1.0

run_detailed_nuts

# Visualize
visualize
