# ============================================================
# BUDA Congestion Demo — three buses crossing a shared center
# ============================================================
# Floorplan: CPU + GPU on the left, MEM + DISP on the right.
# A wide central NOC block creates a narrow Hanan corridor.
# Three buses (64-bit, 16-bit, 16-bit) all want to cross that
# corridor.  The congestion-aware planner spreads them out.
# ============================================================

# --- Layers --------------------------------------------------
def_layer 4 M4 H TOP 0.0
def_layer 5 M5 V TOP 0.0
def_layer 6 M6 H TOP 0.0

# --- Floorplan -----------------------------------------------
#   Left column
add_block u_cpu    50   50  250  500
add_block u_gpu    50  600  250  950

#   Right column
add_block u_mem   950   50 1150  500
add_block u_disp  950  600 1150  950

#   Central NOC — wide obstacle, creates a narrow pinch-point
#   The corridor above (y 500-600) and below (y 0-50 / 950-1000)
#   are the only detour routes around it.
add_block u_noc   450  150  750  850

#   Anchor blocks at top/bottom edges to force Hanan lines there,
#   giving the U-shape detours a concrete trunk position.
add_block u_top_anchor  400    0  800   40
add_block u_bot_anchor  400  960  800 1000

# --- Nets ----------------------------------------------------
#  Bus A: 64-bit CPU -> MEM  (fattest, gets first pick)
add_bus busA[64] u_cpu.tx u_mem.rx

#  Bus B: 16-bit GPU -> DISP
add_bus busB[16] u_gpu.tx u_disp.rx

#  Bus C: 16-bit CPU -> DISP  (diagonal — crosses both H and V cuts)
add_bus busC[16] u_cpu.tx u_disp.rx

# --- Pipeline ------------------------------------------------
run_bundler strict

generate_topologies_for_bundle busA_ u_cpu u_mem
generate_topologies_for_bundle busB_ u_gpu u_disp
generate_topologies_for_bundle busC_ u_cpu u_disp

# Congestion-aware planner: fattest bus first, greedy overflow minimisation
run_planner 1

run_nuts 3.0

visualize
