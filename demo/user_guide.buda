# 0. Chip definition

corner_margin dx 4.0 dy 6.0

add_block unit1      100 100  200 200
add_block unit2      300 300  400 400
add_net   cntr       unit1.tx unit2.rx
add_bus   bus[0:3]   unit2.tx unit1.rx

# 1. Define layers
def_layer 4 M4 H TOP 20.0
def_layer 5 M5 V TOP 30.0

# 2. Define track patterns (Required for run_detailed_nuts)
# Example: 2.0 unit wide SIGNAL tracks with 3.0 unit spacing
def_track_pattern 4 0.0  SIGNAL 2.0 3.0 GND 4.0 2.0 SIGNAL 2.0 3.0 SIGNAL 2.0 3.0 POWER 4.0 2.0
def_track_pattern 5 0.0  SIGNAL 2.0 3.0 GND 4.0 2.0 SIGNAL 2.0 3.0 SIGNAL 2.0 3.0 POWER 4.0 2.0

# 3. Run the pipeline
run_bundler
generate_topologies
run_planner
run_nuts
run_detailed_nuts

# See it
visualize
