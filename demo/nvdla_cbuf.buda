# nvdla_cbuf.buda — NVIDIA NVDLA Partition-C Convolution Buffer (NanGate45)
#
# Source:  NV_NVDLA_partition_c from MacroPlacement repo (TILOS-AI-Institute/MacroPlacement)
#          Flows/NanGate45/nvdla/ ; macro positions from fp_placed_macros.def
#
# Hierarchy: NV_NVDLA_partition_c contains the convolution buffer (cbuf)
#            91 × fakeram45_256x64 SRAMs (4 KB each) arranged as 30 banks
#            (banks 0–31, banks 9 and 10 absent in this placement).
#            Banks 9/10 absent; 30 banks × 2 SRAMs = 60 macros + 31 single = 91 total
#
# Key bus: cbuf address bus.
#   During each cbuf read cycle, the same row-address is broadcast to all
#   banks simultaneously so data can be read out in parallel.
#   fakeram45_256x64 → 8-bit address (log2(256)=8).
#
# Die: 2354 × 2353 µm (NanGate45)
# Layer stack: M7/M8 for inter-bank stubs, M9/M10 for die-spanning trunks.
# (Same layer convention as mempool_cluster.buda)

def_layer 7  M7  H LOW 20 span_min 0    span_max 2354
def_layer 8  M8  V LOW 20 span_min 0    span_max 2353
def_layer 9  M9  H TOP 15 span_min 400  span_max 2354
def_layer 10 M10 V TOP 15 span_min 400  span_max 2353

# NanGate45 track patterns (NangateOpenCellLibrary.tech.lef)
def_track_pattern 7  0.07  (SIGNAL 0.4 0.4)x4  POWER 0.8 0.4  (SIGNAL 0.4 0.4)x4  GROUND 0.8 0.4
def_track_pattern 8  0.095 (SIGNAL 0.4 0.4)x4  POWER 0.8 0.4  (SIGNAL 0.4 0.4)x4  GROUND 0.8 0.4
def_track_pattern 9  0.07  (SIGNAL 0.8 0.8)x4  POWER 1.6 0.8  (SIGNAL 0.8 0.8)x4  GROUND 1.6 0.8
def_track_pattern 10 0.095 (SIGNAL 0.8 0.8)x4  POWER 1.6 0.8  (SIGNAL 0.8 0.8)x4  GROUND 1.6 0.8

corner_margin dx 10 dy 10

# ── Floorplan ─────────────────────────────────────────────────────────────
# cbuf controller (convolution engine addressing logic) — virtual block placed
# at the centroid of all 30 banks (~1150,1150 µm), 100×100 µm footprint.
add_block cbuf_ctrl  1100 1100  1200 1200

# 30 cbuf banks from fp_placed_macros.def (centroid ± 70 µm × 35 µm).
# fakeram45_256x64 macro: ~140 µm wide × 70 µm tall.
add_block cbuf_bank0   988  615  1128  685
add_block cbuf_bank1   493  440   633  510
add_block cbuf_bank2   753  424   893  494
add_block cbuf_bank3   629  824   769  894
add_block cbuf_bank4   856 1155   996 1225
add_block cbuf_bank5  1109 1185  1249 1255
add_block cbuf_bank6   919 1479  1059 1549
add_block cbuf_bank7   638 1287   778 1357
add_block cbuf_bank8   354  921   494  991
add_block cbuf_bank11  479 1510   619 1580
add_block cbuf_bank12  721 2067   861 2137
add_block cbuf_bank13  422 1940   562 2010
add_block cbuf_bank14  706 1718   846 1788
add_block cbuf_bank15  985 1929  1125 1999
add_block cbuf_bank16 1447 1394  1587 1464
add_block cbuf_bank17 1596 1149  1736 1219
add_block cbuf_bank18 1970  949  2110 1019
add_block cbuf_bank19 1353 1073  1493 1143
add_block cbuf_bank20 1235 1521  1375 1591
add_block cbuf_bank21 1239 1949  1379 2019
add_block cbuf_bank22 1590 1963  1730 2033
add_block cbuf_bank23 1522 1697  1662 1767
add_block cbuf_bank24 1235  700  1375  770
add_block cbuf_bank25 1556  644  1696  714
add_block cbuf_bank26 1508  393  1648  463
add_block cbuf_bank27 1886  615  2026  685
add_block cbuf_bank28 2094 1262  2234 1332
add_block cbuf_bank29 1842 1723  1982 1793
add_block cbuf_bank30 2093 1690  2233 1760
add_block cbuf_bank31 1906 1297  2046 1367

# ── Buses ─────────────────────────────────────────────────────────────────
# cbuf address bus: 8 bits (log2(256)), controller → all 30 banks.
# This is the key multicast bus — same row-address goes to every bank
# simultaneously so data can be read out in parallel.
add_bus cbuf_addr[8] cbuf_ctrl.addr_out cbuf_bank0.addr,cbuf_bank1.addr,cbuf_bank2.addr,cbuf_bank3.addr,cbuf_bank4.addr,cbuf_bank5.addr,cbuf_bank6.addr,cbuf_bank7.addr,cbuf_bank8.addr,cbuf_bank11.addr,cbuf_bank12.addr,cbuf_bank13.addr,cbuf_bank14.addr,cbuf_bank15.addr,cbuf_bank16.addr,cbuf_bank17.addr,cbuf_bank18.addr,cbuf_bank19.addr,cbuf_bank20.addr,cbuf_bank21.addr,cbuf_bank22.addr,cbuf_bank23.addr,cbuf_bank24.addr,cbuf_bank25.addr,cbuf_bank26.addr,cbuf_bank27.addr,cbuf_bank28.addr,cbuf_bank29.addr,cbuf_bank30.addr,cbuf_bank31.addr

# cbuf_we (1-bit per bank) omitted: STRICT bundler merges it with cbuf_addr
# (same driver cbuf_ctrl + same 30 receivers = identical signature → 9-bit bundle).
# The write-enable fanout is architecturally identical; model cbuf_addr only.

# ── Pipeline ──────────────────────────────────────────────────────────────
run_bundler strict

generate_topologies_for_bundle cbuf_addr cbuf_ctrl cbuf_bank0 cbuf_bank1 cbuf_bank2 cbuf_bank3 cbuf_bank4 cbuf_bank5 cbuf_bank6 cbuf_bank7 cbuf_bank8 cbuf_bank11 cbuf_bank12 cbuf_bank13 cbuf_bank14 cbuf_bank15 cbuf_bank16 cbuf_bank17 cbuf_bank18 cbuf_bank19 cbuf_bank20 cbuf_bank21 cbuf_bank22 cbuf_bank23 cbuf_bank24 cbuf_bank25 cbuf_bank26 cbuf_bank27 cbuf_bank28 cbuf_bank29 cbuf_bank30 cbuf_bank31

run_planner 50
run_nuts 1.0
run_detailed_nuts

visualize
