# mempool_group.buda — MemPool Group Level (NanGate45)
#
# Source:  MemPool paper (Riedel et al., 2023); ISPD24 MemPool-Group benchmark
# Hierarchy: 1 group = 16 tiles (4×4) + 3 remote interconnect blocks
# Die area:  1100 × 1100 µm  (from OpenROAD-flow-scripts/nangate45/mempool_group/config.mk)
#
# Key bus: inter-group TCDM response path.
#   Each remote IC block fans out TCDM responses to all 16 tiles via a
#   1-to-16 multicast tree. tcdm_master_resp_t = data(32) + meta_id(4) = 36 bits.
#
#   The request direction (16 tiles → 1 IC block) is a fanin scenario;
#   it is not modelled here since BUDA plans 1-to-N trees.
#
#   The AXI bus (512-bit, tree-like instruction-cache + DMA hierarchy) is
#   also modelled as a 1-to-16 multicast from the east-side AXI master.
#
# Layer stack: M5/M6 for tile-span stubs, M7/M8 for group-spanning trunks.

def_layer 5 M5 H LOW 20 span_min 0   span_max 400
def_layer 6 M6 V LOW 20 span_min 0   span_max 400
def_layer 7 M7 H TOP 15 span_min 200 span_max 1100
def_layer 8 M8 V TOP 15 span_min 200 span_max 1100

# NanGate45 track patterns (from NangateOpenCellLibrary.tech.lef + make_tracks.tcl)
# Pattern: 4 SIGNAL + POWER (2× width) + 4 SIGNAL + GROUND per period
# M5: H, width=0.14 µm, pitch=0.28 µm, origin=0.07 µm
def_track_pattern 5 0.07 (SIGNAL 0.14 0.14)x4  POWER 0.28 0.14  (SIGNAL 0.14 0.14)x4  GROUND 0.28 0.14
# M6: V, width=0.14 µm, pitch=0.28 µm, origin=0.095 µm
def_track_pattern 6 0.095 (SIGNAL 0.14 0.14)x4  POWER 0.28 0.14  (SIGNAL 0.14 0.14)x4  GROUND 0.28 0.14
# M7: H, width=0.40 µm, pitch=0.80 µm, origin=0.07 µm
def_track_pattern 7 0.07 (SIGNAL 0.4 0.4)x4  POWER 0.8 0.4  (SIGNAL 0.4 0.4)x4  GROUND 0.8 0.4
# M8: V, width=0.40 µm, pitch=0.80 µm, origin=0.095 µm
def_track_pattern 8 0.095 (SIGNAL 0.4 0.4)x4  POWER 0.8 0.4  (SIGNAL 0.4 0.4)x4  GROUND 0.8 0.4

corner_margin dx 10 dy 10

# ── Floorplan ─────────────────────────────────────────────────────────────
# 16 tiles in a 4×4 grid; each tile 250×250 µm.
# Column x: 10, 260, 510, 760, 1010
# Row    y: 10, 260, 510, 760, 1010
#
#  col →   c0          c1          c2          c3
#  row ↑
#  r3   tile_r3c0   tile_r3c1   tile_r3c2   tile_r3c3   (top)
#  r2   tile_r2c0   tile_r2c1   tile_r2c2   tile_r2c3
#  r1   tile_r1c0   tile_r1c1   tile_r1c2   tile_r1c3
#  r0   tile_r0c0   tile_r0c1   tile_r0c2   tile_r0c3   (bottom)
add_block tile_r0c0   10  10  260 260
add_block tile_r0c1  260  10  510 260
add_block tile_r0c2  510  10  760 260
add_block tile_r0c3  760  10 1010 260
add_block tile_r1c0   10 260  260 510
add_block tile_r1c1  260 260  510 510
add_block tile_r1c2  510 260  760 510
add_block tile_r1c3  760 260 1010 510
add_block tile_r2c0   10 510  260 760
add_block tile_r2c1  260 510  510 760
add_block tile_r2c2  510 510  760 760
add_block tile_r2c3  760 510 1010 760
add_block tile_r3c0   10 760  260 1010
add_block tile_r3c1  260 760  510 1010
add_block tile_r3c2  510 760  760 1010
add_block tile_r3c3  760 760 1010 1010

# Remote interconnect blocks: pipeline-register stages of the butterfly
# crossbar (TopH topology, Fig. 2 of the MemPool paper) that bridge this
# group to the three neighbouring groups in the 2×2 cluster.
#   north_ic — top strip  y=1010–1090: connection to north group
#   east_ic  — right strip x=1010–1090: connection to east group
#   ne_ic    — corner    x/y=1010–1090: connection to northeast group
add_block north_ic   10 1010 1010 1090
add_block east_ic  1010   10 1090 1010
add_block ne_ic    1010 1010 1090 1090

# ── Buses ─────────────────────────────────────────────────────────────────
# TCDM response buses: each IC fans responses out to all 16 tiles.
# Width: 36 bits (tcdm_master_resp_t = data:32 + meta_id:4).
# 3 bundles under STRICT (one per IC direction); each is 1-to-16 multicast.
add_bus north_rsp[36] north_ic.tx tile_r0c0.rx,tile_r0c1.rx,tile_r0c2.rx,tile_r0c3.rx,tile_r1c0.rx,tile_r1c1.rx,tile_r1c2.rx,tile_r1c3.rx,tile_r2c0.rx,tile_r2c1.rx,tile_r2c2.rx,tile_r2c3.rx,tile_r3c0.rx,tile_r3c1.rx,tile_r3c2.rx,tile_r3c3.rx
add_bus east_rsp[36]  east_ic.tx  tile_r0c0.rx,tile_r0c1.rx,tile_r0c2.rx,tile_r0c3.rx,tile_r1c0.rx,tile_r1c1.rx,tile_r1c2.rx,tile_r1c3.rx,tile_r2c0.rx,tile_r2c1.rx,tile_r2c2.rx,tile_r2c3.rx,tile_r3c0.rx,tile_r3c1.rx,tile_r3c2.rx,tile_r3c3.rx
add_bus ne_rsp[36]    ne_ic.tx    tile_r0c0.rx,tile_r0c1.rx,tile_r0c2.rx,tile_r0c3.rx,tile_r1c0.rx,tile_r1c1.rx,tile_r1c2.rx,tile_r1c3.rx,tile_r2c0.rx,tile_r2c1.rx,tile_r2c2.rx,tile_r2c3.rx,tile_r3c0.rx,tile_r3c1.rx,tile_r3c2.rx,tile_r3c3.rx

# AXI system bus (excluded from this file): the group's AXI master port shares
# the same driver instance as east_rsp (east_ic), which would cause the
# bundler to merge them. Model the AXI tree at the cluster level instead,
# where the AXI master is a separate group_axi_master block.

# ── Pipeline ──────────────────────────────────────────────────────────────
run_bundler strict

# TCDM response trees: 1 IC block → 16 tiles (multicast)
generate_topologies_for_bundle north_rsp north_ic tile_r0c0 tile_r0c1 tile_r0c2 tile_r0c3 tile_r1c0 tile_r1c1 tile_r1c2 tile_r1c3 tile_r2c0 tile_r2c1 tile_r2c2 tile_r2c3 tile_r3c0 tile_r3c1 tile_r3c2 tile_r3c3
generate_topologies_for_bundle east_rsp  east_ic  tile_r0c0 tile_r0c1 tile_r0c2 tile_r0c3 tile_r1c0 tile_r1c1 tile_r1c2 tile_r1c3 tile_r2c0 tile_r2c1 tile_r2c2 tile_r2c3 tile_r3c0 tile_r3c1 tile_r3c2 tile_r3c3
generate_topologies_for_bundle ne_rsp    ne_ic    tile_r0c0 tile_r0c1 tile_r0c2 tile_r0c3 tile_r1c0 tile_r1c1 tile_r1c2 tile_r1c3 tile_r2c0 tile_r2c1 tile_r2c2 tile_r2c3 tile_r3c0 tile_r3c1 tile_r3c2 tile_r3c3


run_planner 50
run_nuts 1.0
run_detailed_nuts

visualize
