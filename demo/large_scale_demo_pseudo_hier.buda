# Stage 1 — bundle nets by driver+receiver instance (per-port)
run_bundler strict

# Stage 2 — generate L/Z/U topology candidates (src/dst auto-derived)
generate_topologies

# Stage 3 — congestion-aware topology selection
run_planner 5

# Stage 4 — NUTS abstract track placement
run_nuts

# Stage 9 — detailed per-bit track placement
run_detailed_nuts

# Visualize
visualize
