# ==================================================================
# BUDA Large-Scale Stress-Test Demo — PSEUDO-HIER variant
# 14 container blocks · 108 bundles · tiled leaf sub-blocks
# Fakes a hierarchy: each top block is a transparent `container`
# envelope; every bus port gets its own leaf sub-block so 3-part
# pins route to a distinct point inside the envelope (per-port
# bundling), the way a real hier flow would.
# Per-port bus width capped at 8 bits so each narrow
# leaf landing site is routable (real hier uses shared busterms).
# ==================================================================

# Layers: M4 horizontal, M5 vertical, M6 long-haul horizontal
source ../flow/tracks/tracks.buda

# Top blocks as transparent container envelopes
add_block u_cpu0 200 200 1000 1600 container
add_block u_cpu1 200 2000 1000 3400 container
add_block u_gpu 200 3800 2000 6600 container
add_block u_npu 200 7000 2000 8400 container
add_block u_l3 2400 200 6000 3400 container
add_block u_noc 2400 3800 8400 6600 container
add_block u_hbm0 8800 200 10400 3400 container
add_block u_hbm1 8800 3800 10400 6600 container
add_block u_ddr 8800 7000 10400 8400 container
add_block u_disp 2400 7000 5000 8400 container
add_block u_isp 5600 7000 8400 8400 container
add_block u_pcie 2400 9000 5000 10200 container
add_block u_usb 5600 9000 8400 10200 container
add_block u_sec 8800 9000 10400 10200 container

