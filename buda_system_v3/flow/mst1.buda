# from pull1

def_layer 4 M4 H TOP 33.33
def_layer 5 M5 V TOP 33.33
corner_margin dx 10 dy 8

add_block center  200 0   300  100
add_block topl    0   200 100  300
add_block topr    400 200 500  300 
add_block botl    0     0 100 -100
add_block botr    400   0 500 -100 
add_bus b1[8]     center.o topl.i,topr.i,botl.i,botr.i
add_bus b2[8]     center.o topl.i,topr.i,botl.i
add_bus b3[8]     topl.o topr.i,botl.i,botr.i
add_bus b4[8]     topr.o botl.i,botr.i

# Add a Keepout Zone to verify the toggle button
# add_keepout 650 400 750 600 M4 M5

run_bundler strict
generate_topologies
run_planner
run_nuts
def_track_pattern 4 0.0  POWER 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  GROUND 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5
def_track_pattern 5 0.0  POWER 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  GROUND 2 1  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5  SIGNAL 1 0.5
run_detailed_nuts
visualize
