# ==========================================
# BUDA Scenario: Z-Shape Trunk Selection
# ==========================================

# 1. Floorplan Setup
# Source in Bottom-Left
add_block u_src   100 100 200 200

# Destination in Top-Right
add_block u_dst   800 800 900 900

# Obstacle/Guide in the Center
# The edges of this block (X=400, X=600) become candidate
# locations for the vertical "Trunks" of our Z-shapes.
add_block u_mid   400 400 600 600

# 2. Technology Setup
# Define generic Metal 3 (Horiz) and Metal 4 (Vert)
def_layer 3 M3 H TOP 0.0
def_layer 4 M4 V TOP 0.0

# 3. Connectivity
# A wide bus connecting corners
add_net bus_0 u_src.tx u_dst.rx
add_net bus_1 u_src.tx u_dst.rx
add_net bus_2 u_src.tx u_dst.rx
add_net bus_3 u_src.tx u_dst.rx

# 4. Execution
# Group them into a bundle
run_bundler strict

# Generate topologies. 
# Because u_mid exists between src and dst, the engine will
# generate Z-shapes using X=400 and X=600 as trunks.
run_planner 5

# 5. Result
# This should visualize the bus 'stepping' around the middle block
visualize