# Ariane (CVA6) CPU core — sub-block interconnect planning
#
# Models the 7 major pipeline sub-blocks inside the CPU core area.
# Block positions are estimated from typical CVA6 area proportions
# (frontend ~18%, decode ~8%, issue ~15%, regfile ~10%,
#  ALU ~12%, mult ~12%, LSU ~18%) scaled to fit the core bbox.
#
# 1 BUDA unit ≈ 7 µm  (core area ≈ 140 × 120 units ≈ 1 × 0.85 mm)
#
# Two-row pipeline layout:
#
#   y=0–45  ┌────────────┬──────────┬──────────┐╷
#           │ u_frontend │u_id_stage│ u_issue  ││ u_regfile
#   y=45–75 └────────────┴──────────┴──────────┘│ (full height)
#   y=75–120┌──────────┬──────────┬──────────┐  │
#           │  u_alu   │  u_mult  │  u_lsu   │  │
#           └──────────┴──────────┴──────────┘╵
#
# Row gap (y=45–75, 30 units) is sized to hold the widest cross-row
# horizontal trunk without interval violations.
#
# Key bus widths (real CVA6, scaled ÷8 to net count):
#   rf_rd[20]       2 reg-read ports × 64-bit = 30 units (widest)
#   decode2issue[12]  scoreboard_entry_t × 2   = 18 units
#   issue2alu/mult/lsu[8–10]  fu_data_t fields = 12–15 units
#   br_resolve[4]   branch resolution           = 6 units (long diagonal)

# ── Layer stack ──────────────────────────────────────────────
def_layer 3 M3 V TOP 0.0  span_max 50
def_layer 4 M4 H TOP 0.0  span_max 70
def_layer 5 M5 V TOP 0.0
def_layer 6 M6 H TOP 0.0
def_layer 7 M7 V TOP 0.0  span_min 70

# ── Global corner margin ─────────────────────────────────────
corner_margin dx 5

# ── Floorplan ────────────────────────────────────────────────
# Row 1 — front-end pipeline
add_block u_frontend    0    0   48   45   # fetch + branch prediction unit
add_block u_id_stage   53    0   82   45   # decode / rename
add_block u_issue      87    0  122   45   # scoreboard + issue read operands

# Right column — register file spans full height (connects to both rows)
add_block u_regfile   127    0  140  120   corner_margin dx 3 dy 3

# Row 2 — execution units
add_block u_alu         0   75   40  120   # integer ALU + branch resolve
add_block u_mult       45   75   83  120   # integer multiplier
add_block u_lsu        88   75  122  120   # load-store unit + PTW

# ── Netlist ──────────────────────────────────────────────────
# ── Fetch path ────────────────────────────────────
# fetch_entry_t × NrIssuePorts: PC(64) + instr(32) + branch_info → ÷8
add_bus  fetch2decode[8]    u_frontend.fetch_out  u_id_stage.fetch_in

# ── Decode → issue ────────────────────────────────
# scoreboard_entry_t × 2 (pc, instr, result_type, rd, etc.) → ÷8
add_bus  decode2issue[12]   u_id_stage.decoded    u_issue.instr_in

# ── Register file → issue (operand read) ──────────
# 2 read ports × 64-bit data = 128 bits; net count × 2 ports = 20
add_bus  rf_rd[20]          u_regfile.rs_data     u_issue.op_in

# ── Issue → functional units ──────────────────────
# fu_data_t: op_a(64) + op_b(64) + operator(8) + trans_id(4) → ÷16
add_bus  issue2alu[8]       u_issue.alu_data      u_alu.fu_in
add_bus  issue2mult[8]      u_issue.mult_data     u_mult.fu_in
add_bus  issue2lsu[10]      u_issue.lsu_data      u_lsu.fu_in

# ── Write-back → register file ─────────────────────
# rd(5) + result(64) = 69 bits; ÷8 ≈ 9, round to 6 (shared wb bus)
add_bus  alu2rf[6]          u_alu.wb_result       u_regfile.wr_a
add_bus  mult2rf[6]         u_mult.wb_result      u_regfile.wr_b
add_bus  lsu2rf[6]          u_lsu.wb_result       u_regfile.wr_c

# ── Result forwarding (bypass network) ────────────
# Avoids register-file round-trip on the critical path
add_bus  alu_fwd[6]         u_alu.fwd_result      u_issue.fwd_a
add_bus  lsu_fwd[6]         u_lsu.fwd_result      u_issue.fwd_b

# ── Branch resolution ─────────────────────────────
# ALU computes branch target + taken/not-taken → frontend redirects PC
add_bus  br_resolve[4]      u_alu.br_update       u_frontend.br_in

# ── Stage 1: bundle ──────────────────────────────────────────
run_bundler strict

# ── Stage 2: topologies ──────────────────────────────────────
generate_topologies

# ── Stage 3: global route ────────────────────────────────────
run_planner 5

# ── Stage 4: abstract track placement ────────────────────────
run_nuts 2.0

# ── Stage 4c: redistribute stubs across V and H layers ───────
# issue→{alu,mult,lsu} stubs share a narrow vertical Hanan column;
# post_nuts spreads them across M3/M5/M7 by stub span length.
run_planner post_nuts V 20 38

# ── Visualise ────────────────────────────────────────────────
visualize
