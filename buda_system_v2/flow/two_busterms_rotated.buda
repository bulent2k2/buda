def_layer 4 M4 H TOP 0.0
def_layer 5 M5 V TOP 0.0

corner_margin dx 15 dy 20

add_block u0  400    50   600     250     
add_block u11 800    500 1000     600     
add_block u12 600    600 1000     700     
add_block u13 500    700 1000     800     
add_block u14 400    800 1000     900     
add_block u15 200    900 1000     1000    

add_net n11 u0.tx u11.rx
add_net n12 u0.tx u12.rx
add_net n13 u0.tx u13.rx
add_net n14 u0.tx u14.rx
add_net n15 u0.tx u15.rx

run_bundler strict
generate_topologies
run_planner 1
run_nuts
visualize
