# Two issues to fix:
# 1) for topo gen, hanan grid should use only the busterms of the bundle!
# 2) L-topo selection is ambiguous

def_layer 4 M4 H TOP 0.0
def_layer 5 M5 V TOP 0.0

corner_margin dx 15 dy 20

add_block u0    50   400  250   600
add_block u15   900  200  1000 1000
# this changes the hanan grid and the slide!
add_block u14   800  400  900  1000

add_net n15 u0.tx u15.rx

run_bundler strict
generate_topologies
run_planner 1
run_nuts
#visualize
