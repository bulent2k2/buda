# channel_stress.buda
# 8 top blocks + 8 bottom blocks with a 340-unit horizontal channel.
# 200 nets randomly paired (fixed seed=42) — stress-tests NUTS channel packing.
# Results in 62 bundles.

def_layer 3 M3 V LOW 10.0
# high power % is to force planner to resort to M6
def_layer 4 M4 H TOP 88.0
def_layer 5 M5 V TOP 20.0
def_layer 6 M6 H LOW 20.0
def_layer 7 M7 V LOW 40.0

add_block u_b0    20   20   80   80
add_block u_b1   100   20  160   80
add_block u_b2   180   20  240   80
add_block u_b3   260   20  320   80
add_block u_b4   340   20  400   80
add_block u_b5   420   20  480   80
add_block u_b6   500   20  560   80
add_block u_b7   580   20  640   80

add_block u_t0    20  420   80  480
add_block u_t1   100  420  160  480
add_block u_t2   180  420  240  480
add_block u_t3   260  420  320  480
add_block u_t4   340  420  400  480
add_block u_t5   420  420  480  480
add_block u_t6   500  420  560  480
add_block u_t7   580  420  640  480

source test4_nets.buda

run_bundler strict

# source test4_gen_topo.buda
generate_topologies

run_planner 5
run_nuts 2.0
# OverlapCnt: 61 = 1 m4 + 60 m5

# Default values: [Planner] post_nuts: short<80→M3 (0b), medium (35b), long>200→M7 (27b)
# 2nd try:        [Planner] post_nuts: short<250→M3 (55b), medium (7b), long>350→M7 (0b)
# vertical channel is 400 tall
run_planner post_nuts V 200 300

run_nuts 2.0
# Overlaps  : 22  (M3=16  M5=6)

# These can be done after `visualize`, too!
# major impact to reduce overlaps!
run_nuts_on_layer M3
# Overlaps  : 10  (M3=4  M5=6)

run_nuts_on_layer M5
# Overlaps  : 4  (M3=4)

# has no effect:
run_nuts_on_layer M3

visualize
