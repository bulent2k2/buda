# ============================================================
# ============================================================

# Layers
def_layer 5 M5 V TOP 0.0
def_layer 6 M6 H TOP 0.0

corner_margin 10 10
# ── Floorplan ────────────────────────────────────────────────
add_block u1    50   50   100 100
add_block u2    150  50   200 100
add_block u3    50  150   100 200
add_block u4    150 150   200 200

# ── Net ──────────────────────────────────────────────────────
add_net b1 u1.tx u2.rx
add_net b2 u1.tx u2.rx,u3.rx
add_net b3 u1.tx u2.rx,u3.rx,u4.rx
add_net b4 u2.tx u3.rx,u4.rx,u1.tx
# ── Pipeline ─────────────────────────────────────────────────
run_bundler strict

# Pass all four destination blocks so the CLI dispatches to
# generate_multicast_candidates() instead of generate_candidates().
generate_topologies_for_bundle b1 u1 u2
generate_topologies_for_bundle b2 u1 u2 u3
generate_topologies_for_bundle b3 u1 u2 u3 u4
generate_topologies_for_bundle b4 u2 u3 u4 u1
run_planner 1

# Step through all 18 topologies in wirelength order.
# ← / → arrow keys (or ◀/▶ buttons) cycle through each candidate.
# NOTE: NUTS is omitted — draw_buses() shows segments at their
# nominal (connected) coordinates, which is correct for tree shapes.
# visualize_topologies -all

run_nuts 2.0

# Full visualize shows the planner-selected topology with the
# congestion map overlaid.
visualize
