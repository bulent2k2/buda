add_bus l3ncp5[128] u_l3.l3ncp5.tx u_noc.l3ncp5.rx
add_bus l3ncp6[128] u_l3.l3ncp6.tx u_noc.l3ncp6.rx
add_bus l3ncp7[128] u_l3.l3ncp7.tx u_noc.l3ncp7.rx

add_bus l3ncc0[32] u_l3.l3ncc0.tx u_noc.l3ncc0.rx
add_bus l3ncc1[32] u_l3.l3ncc1.tx u_noc.l3ncc1.rx

add_bus nh0_p0[128] u_noc.nh0_p0.tx u_hbm0.nh0_p0.rx
add_bus nh0_p1[128] u_noc.nh0_p1.tx u_hbm0.nh0_p1.rx
add_bus nh0_p2[128] u_noc.nh0_p2.tx u_hbm0.nh0_p2.rx
add_bus nh0_p3[128] u_noc.nh0_p3.tx u_hbm0.nh0_p3.rx

add_bus nh1_p0[128] u_noc.nh1_p0.tx u_hbm1.nh1_p0.rx
add_bus nh1_p1[128] u_noc.nh1_p1.tx u_hbm1.nh1_p1.rx
add_bus nh1_p2[128] u_noc.nh1_p2.tx u_hbm1.nh1_p2.rx
add_bus nh1_p3[128] u_noc.nh1_p3.tx u_hbm1.nh1_p3.rx

add_bus ndr_p0[64] u_noc.ndr_p0.tx u_ddr.ndr_p0.rx
add_bus ndr_p1[64] u_noc.ndr_p1.tx u_ddr.ndr_p1.rx
add_bus ndr_p2[64] u_noc.ndr_p2.tx u_ddr.ndr_p2.rx
add_bus ndr_p3[64] u_noc.ndr_p3.tx u_ddr.ndr_p3.rx

add_bus ndsp_0[128] u_noc.ndsp_0.tx u_disp.ndsp_0.rx
add_bus ndsp_1[128] u_noc.ndsp_1.tx u_disp.ndsp_1.rx
