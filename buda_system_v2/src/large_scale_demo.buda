add_bus nisp_1[64] u_noc.nisp_1.tx u_isp.nisp_1.rx
add_bus nisp_2[64] u_noc.nisp_2.tx u_isp.nisp_2.rx
add_bus nisp_3[64] u_noc.nisp_3.tx u_isp.nisp_3.rx

add_bus npc__0[32] u_noc.npc__0.tx u_pcie.npc__0.rx
add_bus npc__1[32] u_noc.npc__1.tx u_pcie.npc__1.rx
add_bus npc__2[32] u_noc.npc__2.tx u_pcie.npc__2.rx
add_bus npc__3[32] u_noc.npc__3.tx u_pcie.npc__3.rx
add_bus npc__4[32] u_noc.npc__4.tx u_pcie.npc__4.rx
add_bus npc__5[32] u_noc.npc__5.tx u_pcie.npc__5.rx

add_bus nusb_0[16] u_noc.nusb_0.tx u_usb.nusb_0.rx
add_bus nusb_1[16] u_noc.nusb_1.tx u_usb.nusb_1.rx
add_bus nusb_2[16] u_noc.nusb_2.tx u_usb.nusb_2.rx
add_bus nusb_3[16] u_noc.nusb_3.tx u_usb.nusb_3.rx

add_bus nsec_0[32] u_noc.nsec_0.tx u_sec.nsec_0.rx
add_bus nsec_1[32] u_noc.nsec_1.tx u_sec.nsec_1.rx
add_bus nsec_2[32] u_noc.nsec_2.tx u_sec.nsec_2.rx
add_bus nsec_3[32] u_noc.nsec_3.tx u_sec.nsec_3.rx

add_bus sc0_p0[64] u_sec.sc0_p0.tx u_cpu0.sc0_p0.rx
add_bus sc0_p1[64] u_sec.sc0_p1.tx u_cpu0.sc0_p1.rx

add_bus sc1_p0[64] u_sec.sc1_p0.tx u_cpu1.sc1_p0.rx
add_bus sc1_p1[64] u_sec.sc1_p1.tx u_cpu1.sc1_p1.rx

add_bus isn_p0[32] u_isp.isn_p0.tx u_noc.isn_p0.rx
add_bus isn_p1[32] u_isp.isn_p1.tx u_noc.isn_p1.rx
