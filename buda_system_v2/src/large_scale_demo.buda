# ==================================================================
# BUDA Large-Scale Stress-Test Demo
# 14 blocks · 116 bundles · 8–128-bit buses · M4/M5/M6 layers
# 10% power+clock overhead per layer
# ==================================================================

# Layers: M4 horizontal, M5 vertical, M6 long-haul horizontal
def_layer 4 M4 H TOP 10.0
def_layer 5 M5 V TOP 10.0
def_layer 6 M6 H TOP 10.0

# Floorplan blocks
add_block u_cpu0 200 200 1000 1600
add_block u_cpu1 200 2000 1000 3400
add_block u_gpu 200 3800 2000 6600
add_block u_npu 200 7000 2000 8400
add_block u_l3 2400 200 6000 3400
add_block u_noc 2400 3800 8400 6600
add_block u_hbm0 8800 200 10400 3400
add_block u_hbm1 8800 3800 10400 6600
add_block u_ddr 8800 7000 10400 8400
add_block u_disp 2400 7000 5000 8400
add_block u_isp 5600 7000 8400 8400
add_block u_pcie 2400 9000 5000 10200
add_block u_usb 5600 9000 8400 10200
add_block u_sec 8800 9000 10400 10200

# Buses (vector syntax: add_bus prefix[N] drv rcv)
add_bus c0l3d0[128] u_cpu0.c0l3d0.tx u_l3.c0l3d0.rx
add_bus c0l3d1[128] u_cpu0.c0l3d1.tx u_l3.c0l3d1.rx

add_bus c0l3t0[64] u_cpu0.c0l3t0.tx u_l3.c0l3t0.rx

add_bus c0l3c0[32] u_cpu0.c0l3c0.tx u_l3.c0l3c0.rx

add_bus c1l3d0[128] u_cpu1.c1l3d0.tx u_l3.c1l3d0.rx
add_bus c1l3d1[128] u_cpu1.c1l3d1.tx u_l3.c1l3d1.rx

add_bus c1l3t0[64] u_cpu1.c1l3t0.tx u_l3.c1l3t0.rx

add_bus c1l3c0[32] u_cpu1.c1l3c0.tx u_l3.c1l3c0.rx

add_bus c0ncp0[64] u_cpu0.c0ncp0.tx u_noc.c0ncp0.rx
add_bus c0ncp1[64] u_cpu0.c0ncp1.tx u_noc.c0ncp1.rx
add_bus c0ncp2[64] u_cpu0.c0ncp2.tx u_noc.c0ncp2.rx
add_bus c0ncp3[64] u_cpu0.c0ncp3.tx u_noc.c0ncp3.rx

add_bus c0ncm0[32] u_cpu0.c0ncm0.tx u_noc.c0ncm0.rx
add_bus c0ncm1[32] u_cpu0.c0ncm1.tx u_noc.c0ncm1.rx

add_bus c1ncp0[64] u_cpu1.c1ncp0.tx u_noc.c1ncp0.rx
add_bus c1ncp1[64] u_cpu1.c1ncp1.tx u_noc.c1ncp1.rx
add_bus c1ncp2[64] u_cpu1.c1ncp2.tx u_noc.c1ncp2.rx
add_bus c1ncp3[64] u_cpu1.c1ncp3.tx u_noc.c1ncp3.rx

add_bus c1ncm0[32] u_cpu1.c1ncm0.tx u_noc.c1ncm0.rx
add_bus c1ncm1[32] u_cpu1.c1ncm1.tx u_noc.c1ncm1.rx

add_bus gpncp0[128] u_gpu.gpncp0.tx u_noc.gpncp0.rx
add_bus gpncp1[128] u_gpu.gpncp1.tx u_noc.gpncp1.rx
add_bus gpncp2[128] u_gpu.gpncp2.tx u_noc.gpncp2.rx
add_bus gpncp3[128] u_gpu.gpncp3.tx u_noc.gpncp3.rx
add_bus gpncp4[128] u_gpu.gpncp4.tx u_noc.gpncp4.rx
add_bus gpncp5[128] u_gpu.gpncp5.tx u_noc.gpncp5.rx

add_bus gpncc0[32] u_gpu.gpncc0.tx u_noc.gpncc0.rx
add_bus gpncc1[32] u_gpu.gpncc1.tx u_noc.gpncc1.rx

add_bus gpl3p0[128] u_gpu.gpl3p0.tx u_l3.gpl3p0.rx
add_bus gpl3p1[128] u_gpu.gpl3p1.tx u_l3.gpl3p1.rx
add_bus gpl3p2[128] u_gpu.gpl3p2.tx u_l3.gpl3p2.rx
add_bus gpl3p3[128] u_gpu.gpl3p3.tx u_l3.gpl3p3.rx

add_bus npncp0[64] u_npu.npncp0.tx u_noc.npncp0.rx
add_bus npncp1[64] u_npu.npncp1.tx u_noc.npncp1.rx
add_bus npncp2[64] u_npu.npncp2.tx u_noc.npncp2.rx
add_bus npncp3[64] u_npu.npncp3.tx u_noc.npncp3.rx

add_bus npncc0[32] u_npu.npncc0.tx u_noc.npncc0.rx
add_bus npncc1[32] u_npu.npncc1.tx u_noc.npncc1.rx

add_bus npl3p0[64] u_npu.npl3p0.tx u_l3.npl3p0.rx
add_bus npl3p1[64] u_npu.npl3p1.tx u_l3.npl3p1.rx

add_bus l3ncp0[128] u_l3.l3ncp0.tx u_noc.l3ncp0.rx
add_bus l3ncp1[128] u_l3.l3ncp1.tx u_noc.l3ncp1.rx
add_bus l3ncp2[128] u_l3.l3ncp2.tx u_noc.l3ncp2.rx
add_bus l3ncp3[128] u_l3.l3ncp3.tx u_noc.l3ncp3.rx
