add_bus isn_p3[32] u_isp.isn_p3.tx u_noc.isn_p3.rx

add_bus gdsp_0[128] u_gpu.gdsp_0.tx u_disp.gdsp_0.rx
add_bus gdsp_1[128] u_gpu.gdsp_1.tx u_disp.gdsp_1.rx
add_bus gdsp_2[128] u_gpu.gdsp_2.tx u_disp.gdsp_2.rx
add_bus gdsp_3[128] u_gpu.gdsp_3.tx u_disp.gdsp_3.rx

add_bus pcn_p0[32] u_pcie.pcn_p0.tx u_noc.pcn_p0.rx
add_bus pcn_p1[32] u_pcie.pcn_p1.tx u_noc.pcn_p1.rx
add_bus pcn_p2[32] u_pcie.pcn_p2.tx u_noc.pcn_p2.rx
add_bus pcn_p3[32] u_pcie.pcn_p3.tx u_noc.pcn_p3.rx

add_bus c0sm_0[8] u_cpu0.c0sm_0.tx u_sec.c0sm_0.rx
add_bus c0sm_1[8] u_cpu0.c0sm_1.tx u_sec.c0sm_1.rx

add_bus c1sm_0[8] u_cpu1.c1sm_0.tx u_sec.c1sm_0.rx
add_bus c1sm_1[8] u_cpu1.c1sm_1.tx u_sec.c1sm_1.rx

add_bus c0pm_0[8] u_cpu0.c0pm_0.tx u_pcie.c0pm_0.rx

add_bus c0um_0[8] u_cpu0.c0um_0.tx u_usb.c0um_0.rx

# Stage 1 — bundle nets by driver+receiver instance
run_bundler strict

# Stage 2 — generate L/Z/U topology candidates per bundle
generate_topologies_for_bundle c0l3d0_ u_cpu0 u_l3
generate_topologies_for_bundle c0l3d1_ u_cpu0 u_l3
generate_topologies_for_bundle c0l3t0_ u_cpu0 u_l3
generate_topologies_for_bundle c0l3c0_ u_cpu0 u_l3
generate_topologies_for_bundle c1l3d0_ u_cpu1 u_l3
generate_topologies_for_bundle c1l3d1_ u_cpu1 u_l3
generate_topologies_for_bundle c1l3t0_ u_cpu1 u_l3
generate_topologies_for_bundle c1l3c0_ u_cpu1 u_l3
